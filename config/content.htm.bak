      (await installLocalModule(pyodide, "./../downloads/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    try {
      targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(pyodide, targets[i]);
      }
      status("");
    } catch (e) {
      status("渲染失敗：" + e);
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
// ]]></script>
<h1>巽木</h1>



























<p class="meta">本宮統八卦，依世變為一世至五世，再為游魂、歸魂。下列四組為第二層分類。</p>
<p class="meta">[[巽]]</p>
<p>巽卦之所以稱為「木」，是因為巽卦代表風，而風具有流動、滲透、柔順、傳播與無孔不入的特性。這些特性與五行之木所代表的生長、延伸、伸展及條達相互呼應。</p>
<p>不過，巽卦與震卦雖然同樣屬木，兩者代表的木性卻有很大的差異：</p>
<ul>
<li>震卦為雷，代表陽氣從地下發動，象徵木的萌芽與生長。</li>
<li>巽卦為風，代表力量柔順地進入萬物，象徵木的延伸、伸展與滲透。</li>
</ul>
<p>這是理解巽卦屬木最重要的觀念。</p>
<h4>一、巽卦的基本卦象</h4>
<p>巽卦的符號是：</p>
<h4>☴ 巽卦</h4>
<h4>━　━</h4>
<h4>━━━</h4>
<h4>━━━</h4>
<p>上面兩爻為陰，下面一爻為陽</p>
<p>巽卦的三爻結構：</p>
<ul>
<li>初爻：陽爻。</li>
<li>二爻：陽爻。</li>
<li>三爻：陰爻。</li>
</ul>
<p>也就是說，兩個陽爻在下方，一個陰爻在上方。</p>
<p>這個結構與震卦恰好相反：</p>
<table>
<thead>
<tr>
<th>比較</th>
<th>震卦 ☳</th>
<th>巽卦 ☴</th>
</tr>
</thead>
<tbody>
<tr>
<td>陽爻</td>
<td>一陽在下</td>
<td>二陽在下</td>
</tr>
<tr>
<td>陰爻</td>
<td>二陰在上</td>
<td>一陰在上</td>
</tr>
<tr>
<td>五行</td>
<td>木</td>
<td>木</td>
</tr>
<tr>
<td>自然</td>
<td>雷</td>
<td>風</td>
</tr>
<tr>
<td>特性</td>
<td>發動、震動</td>
<td>柔順、滲透</td>
</tr>
</tbody>
</table>
<p>《說卦傳》對巽卦有一段重要描述：</p>
<blockquote>
<p>巽，入也。</p>
</blockquote>
<p>又說：</p>
<blockquote>
<p>巽為木，為風，為長女，為繩直，為工，為白，為長，為高……</p>
</blockquote>
<p>這裡直接指出巽為木、為風，也指出巽具有進入、延伸的特性。</p>
<h4>二、為什麼風可以代表木？</h4>
<p>可以從四種自然現象來理解。</p>
<p>1. 柔順：木隨風而動</p>
<p>樹木的枝葉會隨風擺動，不會永遠保持僵硬的狀態。這與巽卦柔順、順應環境的性質相符合。</p>
<p>2. 延伸：木不斷向外生長</p>
<p>樹根向地下延伸，枝條向四周伸展。這與巽卦的深入、延伸及擴展相互呼應。</p>
<p>3. 滲透：風能進入各種空間</p>
<p>風可以穿過樹林、山谷、門窗與縫隙。巽卦的「入」正是這種無孔不入的象徵。</p>
<p>4. 生長：木具有向上與向外的生命力</p>
<p>植物可以持續伸展枝葉、向上生長。巽卦的柔和力量，象徵一種持續而不強迫的發展方式。</p>
<p>因此，巽卦與木的共同特性可以歸納為：</p>
<p>柔順、伸展、滲透、延續、生長。</p>
<h4>三、巽卦與震卦為什麼同屬木？</h4>
<p>這是八卦五行中非常值得深入研究的地方。</p>
<p>震與巽分別代表雷與風，兩者在自然界中也經常同時出現。</p>
<h4>震卦 ☳</h4>
<p>陽木</p>
<p>一陽在下，力量開始發動。</p>
<ul>
<li>雷</li>
<li>震動</li>
<li>突破</li>
<li>萌芽</li>
<li>主動生長</li>
</ul>
<h4>巽卦 ☴</h4>
<p>陰木</p>
<p>一陰在上，力量柔順進入。</p>
<ul>
<li>風</li>
<li>滲透</li>
<li>柔順</li>
<li>延伸</li>
<li>持續發展</li>
</ul>
<table>
<thead>
<tr>
<th>比較</th>
<th>震卦</th>
<th>巽卦</th>
</tr>
</thead>
<tbody>
<tr>
<td>五行</td>
<td>木</td>
<td>木</td>
</tr>
<tr>
<td>陰陽分類</td>
<td>陽木</td>
<td>陰木</td>
</tr>
<tr>
<td>自然</td>
<td>雷</td>
<td>風</td>
</tr>
<tr>
<td>方位</td>
<td>東</td>
<td>東南</td>
</tr>
<tr>
<td>季節意象</td>
<td>春</td>
<td>春末至初夏</td>
</tr>
<tr>
<td>家庭</td>
<td>長男</td>
<td>長女</td>
</tr>
<tr>
<td>身體</td>
<td>足</td>
<td>股（大腿）</td>
</tr>
<tr>
<td>主要力量</td>
<td>發動</td>
<td>滲透</td>
</tr>
<tr>
<td>行為特徵</td>
<td>剛健、主動</td>
<td>柔順、深入</td>
</tr>
</tbody>
</table>
<p>這裡的陽木、陰木是後世五行象義的延伸分類。</p>
<p>可以用植物生長來比喻：</p>
<ul>
<li>震卦像種子突破泥土，開始發芽。</li>
<li>巽卦像植物長出枝條與根系，不斷向外延伸。</li>
</ul>
<p>兩者都是木的生命力量，只是發展階段與表現方式不同。</p>
<h4>四、為什麼巽卦位於東南方？</h4>
<p>在後天八卦中，巽卦位於東南方。</p>
<table>
<thead>
<tr>
<th>項目</th>
<th>巽卦</th>
</tr>
</thead>
<tbody>
<tr>
<td>卦象</td>
<td>☴</td>
</tr>
<tr>
<td>自然</td>
<td>風、木</td>
</tr>
<tr>
<td>方位</td>
<td>東南</td>
</tr>
<tr>
<td>五行</td>
<td>木</td>
</tr>
<tr>
<td>季節</td>
<td>春夏交替</td>
</tr>
<tr>
<td>家庭</td>
<td>長女</td>
</tr>
<tr>
<td>身體</td>
<td>股、大腿</td>
</tr>
<tr>
<td>顏色（常見五行象義）</td>
<td>青、綠</td>
</tr>
<tr>
<td>先天數</td>
<td>五</td>
</tr>
<tr>
<td>後天數</td>
<td>四</td>
</tr>
</tbody>
</table>
<p>為什麼東南方屬木？</p>
<p>可以從自然與季節的變化理解：</p>
<ol>
<li>東方代表春天，萬物開始萌芽。</li>
<li>東南方承接春天的生長力量。</li>
<li>植物開始茂盛，枝葉向外伸展。</li>
<li>風在自然界中促進花粉、種子及氣候的傳播。</li>
</ol>
<p>因此形成：</p>
<p>東南方 → 春夏交替 → 木 → 巽卦。</p>
<p>要注意，這是傳統方位與季節的象徵對應，不是說東南方在現代氣象學上必然具有某種固定風向。</p>
<h4>五、巽卦在六十四卦中的意義</h4>
<p>巽卦上下重疊，形成六十四卦中的第五十七卦：</p>
<h4>巽為風 ☴</h4>
<h4>━　━</h4>
<h4>━━━</h4>
<h4>━━━</h4>
<h4>━　━</h4>
<h4>━━━</h4>
<h4>━━━</h4>
<p>上下皆巽，象徵風行不息、深入萬物</p>
<p>巽卦卦辭：</p>
<blockquote>
<p>巽，小亨，利有攸往，利見大人。</p>
</blockquote>
<p>可以從人生哲學理解：</p>
<ul>
<li>巽：柔順、進入、順勢而行。</li>
<li>小亨：循序漸進，可以獲得通達。</li>
<li>利有攸往：適合有所前往、有所行動。</li>
<li>利見大人：適合尋求有智慧、有經驗者的指引。</li>
</ul>
<p>巽卦的智慧在於：不一定要用強大的力量突破障礙，有時候持續、柔和地深入，反而能達到目的。</p>
<p>例如：</p>
<ul>
<li>學習一門新技術，每天累積一點。</li>
<li>經營人際關係，透過溝通逐漸建立信任。</li>
<li>解決複雜問題，從細節逐步深入。</li>
<li>推動改革，透過持續影響而非強迫達成目標。</li>
</ul>
<p>巽卦告訴我們：柔順不代表軟弱，持續深入也可以產生強大的力量。</p>
<h4>六、目前七卦的五行對照</h4>
<p>到目前為止，我們已經討論了七個卦，整理如下：</p>
<table>
<thead>
<tr>
<th>卦</th>
<th>卦象</th>
<th>自然</th>
<th>五行</th>
<th>方位</th>
<th>核心特性</th>
</tr>
</thead>
<tbody>
<tr>
<td>乾</td>
<td>☰</td>
<td>天</td>
<td>金</td>
<td>西北</td>
<td>剛健</td>
</tr>
<tr>
<td>兌</td>
<td>☱</td>
<td>澤</td>
<td>金</td>
<td>西</td>
<td>喜悅</td>
</tr>
<tr>
<td>離</td>
<td>☲</td>
<td>火</td>
<td>火</td>
<td>南</td>
<td>光明</td>
</tr>
<tr>
<td>震</td>
<td>☳</td>
<td>雷</td>
<td>木</td>
<td>東</td>
<td>發動</td>
</tr>
<tr>
<td>巽</td>
<td>☴</td>
<td>風</td>
<td>木</td>
<td>東南</td>
<td>滲透</td>
</tr>
<tr>
<td>坎</td>
<td>☵</td>
<td>水</td>
<td>水</td>
<td>北</td>
<td>流動</td>
</tr>
<tr>
<td>艮</td>
<td>☶</td>
<td>山</td>
<td>土</td>
<td>東北</td>
<td>停止</td>
</tr>
<tr>
<td>坤</td>
<td>☷</td>
<td>地</td>
<td>土</td>
<td>西南</td>
<td>承載</td>
</tr>
</tbody>
</table>
<p>七、八卦五行其實可以看成自然界的八種力量</p>
<p>這裡將目前七卦的特性進一步整理：</p>
<table>
<thead>
<tr>
<th>五行</th>
<th>八卦</th>
<th>自然現象</th>
<th>主要生命力量</th>
</tr>
</thead>
<tbody>
<tr>
<td>木</td>
<td>震、巽</td>
<td>雷、風</td>
<td>萌發、伸展</td>
</tr>
<tr>
<td>火</td>
<td>離</td>
<td>火</td>
<td>光明、發散</td>
</tr>
<tr>
<td>土</td>
<td>艮、坤</td>
<td>山、地</td>
<td>穩固、承載</td>
</tr>
<tr>
<td>金</td>
<td>乾、兌</td>
<td>天、澤</td>
<td>剛健、收斂</td>
</tr>
<tr>
<td>水</td>
<td>坎</td>
<td>水</td>
<td>流動、收藏</td>
</tr>
</tbody>
</table>
<p>這裡要特別注意：八卦是八種自然象徵，五行則是五種分類與運行模式，兩者是不同層次的系統，不能簡單視為完全相同。</p>
<p>
<script src="https://cdn.jsdelivr.net/pyodide/v0.27.0/full/pyodide.js"></script>
<script>
(function () {
  "use strict";

  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, CODE: 1, PRE: 1 };

  function status(msg) {
    var el = document.getElementById("gua_status");
    if (el) el.textContent = msg || "";
  }

  function hasMarkup(text) {
    return text && text.indexOf("[[") !== -1 && text.indexOf("]]") !== -1;
  }

  /** 找出含 [[...]] 且適合替換的元素（略過 script/style 等） */
  function findMarkupElements(root) {
    var result = [];
    var all = (root || document.body).getElementsByTagName("*");
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (SKIP[el.tagName]) continue;
      if (el.id === "gua_status") continue;
      // 只處理「自身有文字、且子元素沒有再包一層含標記的容器」的節點，
      // 或明確標了 class="gua-markup"
      var text = el.innerText || el.textContent || "";
      if (!hasMarkup(text)) continue;
      if (el.classList && el.classList.contains("gua-markup")) {
        result.push(el);
        continue;
      }
      // 若子元素也有標記，交給子元素處理，避免重複
      var childHas = false;
      for (var j = 0; j < el.children.length; j++) {
        var ct = el.children[j].innerText || el.children[j].textContent || "";
        if (hasMarkup(ct)) { childHas = true; break; }
      }
      if (!childHas) result.push(el);
    }
    return result;
  }

  async function installLocalModule(pyodide, url, name) {
    try {
      var res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return false;
      var code = await res.text();
      if (!code || !code.trim()) return false;
      pyodide.FS.writeFile(name + ".py", code);
      return true;
    } catch (e) {
      console.warn("change.py 載入失敗", url, e);
      return false;
    }
  }

  async function renderElement(pyodide, el) {
    var text = el.innerText || el.textContent || "";
    if (!hasMarkup(text)) return;
    pyodide.globals.set("_gua_src", text);
    var html = await pyodide.runPythonAsync(
      "import change\n" +
      "change.render_markup(_gua_src, target_div=None, default_method='html', lang='zh')\n"
    );
    if (html) el.innerHTML = html;
  }

  async function main() {
    if (!document.body) {
      setTimeout(main, 100);
      return;
    }

    var targets = findMarkupElements(document.body);
    if (targets.length === 0) {
      // 內容可能稍後才出現（ViewPage 動態載入）
      if (!main._tries) main._tries = 0;
      if (main._tries++ < 20) {
        setTimeout(main, 300);
      }
      return;
    }

    if (typeof loadPyodide !== "function") {
      status("Pyodide 尚未載入…");
      setTimeout(main, 400);
      return;
    }

    status("載入卦象元件…");
    var pyodide;
    try {
      pyodide = await loadPyodide();
    } catch (e) {
      status("Pyodide 失敗：" + e);
      return;
    }

    var ok =
      (await installLocalModule(pyodide, "/static/change.py", "change")) ||
      (await installLocalModule(pyodide, "/downloads/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../static/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../downloads/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    try {
      targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(pyodide, targets[i]);
      }
      status("");
    } catch (e) {
      status("渲染失敗：" + e);
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
</script>
</p>
<h2>本宮與一世-1-1-1-1-1</h2>














































<ul class="plain">
<li>
<h3>本宮 · 巽為風</h3>














































<p>（文王第 57 卦） · <a href="../gua/57_巽.html">詳頁</a> · 標記 [[ 巽 ]]</p>
<script src="https://cdn.jsdelivr.net/pyodide/v0.27.0/full/pyodide.js"></script>
<script>// <![CDATA[
