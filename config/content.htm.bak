<h2>卜卦</h2>











<!-- 放在 body 內。含：[[標記]]自動渲染 + 亂數卜卦 -->
<div class="gua-cast-box"><strong>亂數卜卦</strong>
<p style="margin: 6px 0; font-size: 14px; color: #555;">以三枚銅錢法（六次）起卦。陽＝少陽／老陽，陰＝少陰／老陰；老陰老陽為動爻。</p>
<button type="button" id="gua_cast_btn">開始卜卦</button> <button type="button" id="gua_cast_clear">清除結果</button>
<div id="gua_cast_result"><br></div>
</div>
<p class="gua-status" id="gua_status"><br></p>
<script src="https://cdn.jsdelivr.net/pyodide/v0.27.0/full/pyodide.js"></script>
<script>
(function () {
  "use strict";

  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, CODE: 1, PRE: 1 };
  var pyodide = null;
  var ready = false;

  function status(msg) {
    var el = document.getElementById("gua_status");
    if (el) el.textContent = msg || "";
  }

  function hasMarkup(text) {
    return text && text.indexOf("[[") !== -1 && text.indexOf("]]") !== -1;
  }

  function findMarkupElements(root) {
    var result = [];
    var all = (root || document.body).getElementsByTagName("*");
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (SKIP[el.tagName]) continue;
      if (el.id === "gua_status" || el.id === "gua_cast_result") continue;
      var text = el.innerText || el.textContent || "";
      if (!hasMarkup(text)) continue;
      if (el.classList && el.classList.contains("gua-markup")) {
        result.push(el);
        continue;
      }
      var childHas = false;
      for (var j = 0; j < el.children.length; j++) {
        var ct = el.children[j].innerText || el.children[j].textContent || "";
        if (hasMarkup(ct)) { childHas = true; break; }
      }
      if (!childHas) result.push(el);
    }
    return result;
  }

  async function installLocalModule(url, name) {
    try {
      var res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return false;
      var code = await res.text();
      if (!code || !code.trim()) return false;
      pyodide.FS.writeFile(name + ".py", code);
      return true;
    } catch (e) {
      console.warn("change.py 載入失敗", url, e);
      return false;
    }
  }

  async function renderElement(el) {
    var text = el.innerText || el.textContent || "";
    if (!hasMarkup(text)) return;
    pyodide.globals.set("_gua_src", text);
    var html = await pyodide.runPythonAsync(
      "import change\n" +
      "change.render_markup(_gua_src, target_div=None, default_method='html', lang='zh')\n"
    );
    if (html) el.innerHTML = html;
  }

  // ---- 三枚銅錢起卦（JS）----
  // 每次：三幣，字=3 背=2；和 6=老陰 7=少陽 8=少陰 9=老陽
  // 本卦：6/8→陰(0)  7/9→陽(1)；由下往上六爻，再轉成「由上到下」binary 給 change.py
  function castCoins() {
    var linesBottomUp = []; // {val:0|1, moving:bool, coin:6|7|8|9}
    for (var i = 0; i < 6; i++) {
      var s = 0;
      for (var c = 0; c < 3; c++) s += Math.random() < 0.5 ? 2 : 3;
      var val = (s === 7 || s === 9) ? 1 : 0;
      var moving = (s === 6 || s === 9);
      linesBottomUp.push({ val: val, moving: moving, coin: s });
    }
    // binary 上→下
    var primary = "";
    var changed = "";
    var movingIdx = []; // 1=初 … 6=上
    for (var k = 5; k >= 0; k--) {
      primary += String(linesBottomUp[k].val);
      var v = linesBottomUp[k].val;
      if (linesBottomUp[k].moving) {
        v = 1 - v;
        movingIdx.push(k + 1);
      }
      changed += String(v);
    }
    // movingIdx was bottom-up position; convert: bottom idx0=初爻=1
    movingIdx = [];
    for (var m = 0; m < 6; m++) {
      if (linesBottomUp[m].moving) movingIdx.push(m + 1); // 1=初
    }
    return {
      lines: linesBottomUp,
      primary: primary,
      changed: changed,
      moving: movingIdx
    };
  }

  async function doCast() {
    if (!ready || !pyodide) {
      status("元件尚未就緒，請稍候…");
      return;
    }
    var box = document.getElementById("gua_cast_result");
    if (!box) return;
    box.innerHTML = "起卦中…";

    var cast = castCoins();
    pyodide.globals.set("_bin1", cast.primary);
    pyodide.globals.set("_bin2", cast.changed);
    pyodide.globals.set("_moving", cast.moving.join(","));

    try {
      var resultHtml = await pyodide.runPythonAsync(`
import change
from js import document

b1 = str(_bin1)
b2 = str(_bin2)
moving_s = str(_moving)
moving = [int(x) for x in moving_s.split(",") if x.strip()] if moving_s else []

name1 = change.get_name(b1, lang="zh")
html1 = change.draw(b1, target_div=None, method="html", lang="zh", width=140)

# 簡要卦辭（內建摘要）
INFO = {
"111111": ("乾", "元亨利貞。", "大通而利於守正。剛健中正，自強不息。"),
"000000": ("坤", "元亨，利牝馬之貞。", "柔順承載，安貞則吉。厚德載物。"),
"010001": ("屯", "元亨利貞，勿用有攸往，利建侯。", "始生艱難，宜立根基，勿急進。"),
"100010": ("蒙", "亨。童蒙求我。", "蒙昧待啟，虛心受教則吉。"),
"010111": ("需", "有孚，光亨，貞吉。利涉大川。", "待時而進，有誠則可涉險。"),
"111010": ("訟", "有孚，窒。惕中吉。終凶。", "爭訟宜止，見大人、戒終訟。"),
"000010": ("師", "貞，丈人，吉無咎。", "用眾以正，老成持重則吉。"),
"010000": ("比", "吉。原筮元永貞，無咎。", "親比依附，後夫凶。"),
"110111": ("小畜", "亨。密雲不雨，自我西郊。", "小有積蓄，密雲未雨。"),
"111011": ("履", "履虎尾，不咥人，亨。", "謹慎踐行，可履險而無咎。"),
"000111": ("泰", "小往大來，吉亨。", "天地交泰，通達和順。"),
"111000": ("否", "否之匪人，不利君子貞。", "閉塞不通，君子宜斂德。"),
"111101": ("同人", "同人於野，亨。", "與人和同於公，利涉大川。"),
"101111": ("大有", "元亨。", "大有得，光明普照。"),
"000100": ("謙", "亨，君子有終。", "謙虛不矜，終有善果。"),
"001000": ("豫", "利建侯行師。", "和樂預備，宜立業用眾。"),
"011001": ("隨", "元亨利貞，無咎。", "適時而隨，無有咎害。"),
"100110": ("蠱", "元亨，利涉大川。", "整治弊亂，可涉大難。"),
"000011": ("臨", "元亨利貞。至于八月有凶。", "臨人以正；盛極須戒。"),
"110000": ("觀", "盥而不薦，有孚顒若。", "觀仰與示範，誠意莊嚴。"),
"101001": ("噬嗑", "亨。利用獄。", "咬合除梗，宜於明斷。"),
"100101": ("賁", "亨。小利有攸往。", "文飾之美，小往有利。"),
"100000": ("剝", "不利有攸往。", "剝落之時，不宜有所往。"),
"000001": ("復", "亨。反復其道，七日來復。", "一陽來復，利有攸往。"),
"111001": ("無妄", "元亨利貞。其匪正有眚。", "真實不妄；不正則有災。"),
"100111": ("大畜", "利貞，不家食吉，利涉大川。", "大積蓄，養賢致用。"),
"100001": ("頤", "貞吉。觀頤，自求口實。", "頤養守正，慎言語飲食。"),
"011110": ("大過", "棟橈，利有攸往，亨。", "非常之時，棟梁過重。"),
"010010": ("坎", "習坎，有孚，維心亨。", "重險之中，誠則心通。"),
"101101": ("離", "利貞，亨。畜牝牛，吉。", "附麗光明，柔順則吉。"),
"011100": ("咸", "亨，利貞，取女吉。", "彼此感應，以正則吉。"),
"001110": ("恆", "亨，無咎，利貞，利有攸往。", "恆久守正，利有所往。"),
"111100": ("遯", "亨，小利貞。", "及時退避，小有利貞。"),
"001111": ("大壯", "利貞。", "剛健大壯，宜於守正。"),
"101000": ("晉", "康侯用錫馬蕃庶，晝日三接。", "進而上升，柔順光明。"),
"000101": ("明夷", "利艱貞。", "明傷於下，艱中守正。"),
"110101": ("家人", "利女貞。", "家道以正，女正位乎內。"),
"101011": ("睽", "小事吉。", "乖離之中，宜小事。"),
"010100": ("蹇", "利西南，不利東北；利見大人。", "蹇難，利見大人。"),
"001010": ("解", "利西南，其來復吉。有攸往，夙吉。", "舒解緩難，宜早宜復。"),
"100011": ("損", "有孚，元吉，無咎，可貞。", "減損有誠，可獲大吉。"),
"110001": ("益", "利有攸往，利涉大川。", "增益於下，利於進取。"),
"011111": ("夬", "揚于王庭，孚號，有厲。", "決去陰柔，宜告不宜即戎。"),
"111110": ("姤", "女壯，勿用取女。", "陰遇陽，相遇當慎。"),
"011000": ("萃", "亨。王假有廟，利見大人。", "會聚，利見大人。"),
"000110": ("升", "元亨，用見大人，勿恤，南征吉。", "積小成高，南征吉。"),
"011010": ("困", "亨，貞，大人吉，無咎。", "困中守正，大人吉。"),
"010110": ("井", "改邑不改井。", "井養不窮，修德惠人。"),
"011101": ("革", "己日乃孚。元亨利貞，悔亡。", "變革待時，信而後行。"),
"101110": ("鼎", "元吉，亨。", "鼎新養賢，大吉亨通。"),
"001001": ("震", "亨。震來虩虩，笑言啞啞。", "震動警醒，先懼後安。"),
"100100": ("艮", "艮其背，不獲其身，無咎。", "止於其所，得止無咎。"),
"110100": ("漸", "女歸吉，利貞。", "循序漸進，女歸吉。"),
"001011": ("歸妹", "征凶，無攸利。", "歸嫁失正，征則凶。"),
"001101": ("豐", "亨。王假之，勿憂，宜日中。", "豐盛，宜如日中。"),
"101100": ("旅", "小亨，旅貞吉。", "羈旅在外，守正則吉。"),
"110110": ("巽", "小亨，利有攸往，利見大人。", "遜順申命，利見大人。"),
"011011": ("兌", "亨，利貞。", "喜悅和樂，利於守正。"),
"110010": ("渙", "亨。王假有廟，利涉大川。", "離散可濟，利涉大川。"),
"010011": ("節", "亨。苦節不可貞。", "節制有度，苦節不可久。"),
"110011": ("中孚", "豚魚吉，利涉大川，利貞。", "中心誠信，可感於物。"),
"001100": ("小過", "亨，利貞，可小事，不可大事。", "小過，宜下不宜上。"),
"010101": ("既濟", "亨，小利貞，初吉終亂。", "事已成，慎終防亂。"),
"101010": ("未濟", "亨，小狐汔濟，濡其尾，無攸利。", "未完成，仍有可為之機。"),
}

def info(b):
    return INFO.get(b, (change.get_name(b), "", "請依卦象與處境體會。"))

n1, g1, e1 = info(b1)
parts = []
parts.append("<p><strong>本卦：" + name1 + "</strong></p>")
parts.append(html1)
parts.append("<p><em>卦辭：</em>" + g1 + "</p>")
parts.append("<p><em>大意：</em>" + e1 + "</p>")

labels = ["初", "二", "三", "四", "五", "上"]
# lines bottom-up from binary: b1 is top-to-bottom
line_txt = []
for i, ch in enumerate(reversed(b1)):
    lab = labels[i]
    kind = "陽" if ch == "1" else "陰"
    mov = "（動）" if (i + 1) in moving else ""
    line_txt.append(lab + "爻 " + kind + mov)
parts.append("<p class='lines'>" + "\\n".join(line_txt) + "</p>")

if moving and b2 != b1:
    name2 = change.get_name(b2, lang="zh")
    html2 = change.draw(b2, target_div=None, method="html", lang="zh", width=140)
    n2, g2, e2 = info(b2)
    parts.append("<hr><p><strong>之卦（變卦）：" + name2 + "</strong></p>")
    parts.append("<p>動爻：" + "、".join(labels[i-1] for i in moving) + "</p>")
    parts.append(html2)
    parts.append("<p><em>卦辭：</em>" + g2 + "</p>")
    parts.append("<p><em>大意：</em>" + e2 + "</p>")
else:
    parts.append("<p>（無動爻，或動後仍同卦）</p>")

parts.append("<p style='font-size:13px;color:#666;'>警語：內容僅供參考。</p>")
"".join(parts)
`);
      box.innerHTML = resultHtml;
      status("");
    } catch (e) {
      box.innerHTML = "卜卦失敗：" + e;
      console.error(e);
    }
  }

  async function main() {
    if (!document.body) {
      setTimeout(main, 100);
      return;
    }

    if (typeof loadPyodide !== "function") {
      status("Pyodide 尚未載入…");
      setTimeout(main, 400);
      return;
    }

    status("載入卦象元件…");
    try {
      pyodide = await loadPyodide();
    } catch (e) {
      status("Pyodide 失敗：" + e);
      return;
    }

    var ok =
      (await installLocalModule("/static/change.py", "change")) ||
      (await installLocalModule("/downloads/change.py", "change")) ||
      (await installLocalModule("./../static/change.py", "change")) ||
      (await installLocalModule("./../downloads/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    ready = true;
    status("");

    // 綁定卜卦按鈕
    var btn = document.getElementById("gua_cast_btn");
    if (btn) btn.onclick = function () { doCast(); };
    var clr = document.getElementById("gua_cast_clear");
    if (clr) clr.onclick = function () {
      var box = document.getElementById("gua_cast_result");
      if (box) box.innerHTML = "";
    };

    // 原有標記渲染
    try {
      var targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(targets[i]);
      }
    } catch (e) {
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
</script>
<h3>人生智慧</h3>












<div class="gua-cast-box"><button type="button" id="gua_cast_btn">開始卜卦</button> <button type="button" id="gua_wisdom_btn" disabled="disabled">請給建議</button> <button type="button" id="gua_cast_clear">清除結果</button>
<div id="gua_cast_result"><br></div>
<div id="gua_wisdom_result" class="gua-wisdom-result" aria-live="polite"><br></div>
</div>
<p class="gua-status" id="gua_status"><br></p>
<p><br></p>
<script src="https://cdn.jsdelivr.net/pyodide/v0.27.0/full/pyodide.js"></script>
<script>
(function () {
  "use strict";

  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, CODE: 1, PRE: 1 };
  var pyodide = null;
  var ready = false;
  var currentCast = null;
  var wisdomDB = null;

  function escapeHtml(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function (ch) {
      return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch];
    });
  }

  async function loadWisdom() {
    var urls = ["/static/wisdom.json", "/downloads/wisdom.json", "./wisdom.json", "../static/wisdom.json"];
    for (var i = 0; i < urls.length; i++) {
      try {
        var response = await fetch(urls[i], { cache: "no-store" });
        if (response.ok) {
          wisdomDB = await response.json();
          if (wisdomDB && wisdomDB.hexagrams) return true;
        }
      } catch (e) {}
    }
    return false;
  }

  function wisdomCard(title, body, cssClass) {
    return '<section class="gua-wisdom-card ' + (cssClass || '') + '">' +
      '<h4>' + escapeHtml(title) + '</h4><p>' + escapeHtml(body) + '</p></section>';
  }

  function showWisdom() {
    var box = document.getElementById("gua_wisdom_result");
    if (!box || !currentCast || !wisdomDB) {
      if (box) box.innerHTML = '<p>人生智慧資料尚未載入，請確認 wisdom.json 路徑。</p>';
      return;
    }
    var primary = wisdomDB.hexagrams[currentCast.primary];
    var changed = wisdomDB.hexagrams[currentCast.changed];
    if (!primary) {
      box.innerHTML = '<p>找不到本卦的人生智慧資料。</p>';
      return;
    }
    var out = '<div class="gua-wisdom-heading"><strong>本卦人生智慧｜第' +
      primary.number + '卦・' + escapeHtml(primary.name) + '</strong></div>';
    out += wisdomCard("卦辭智慧", primary.summary, "primary");
    if (currentCast.moving.length) {
      out += '<h4>動爻提醒</h4>';
      currentCast.moving.slice().sort(function(a,b){return a-b;}).forEach(function(pos) {
        var item = primary.lines[pos - 1];
        if (item) out += wisdomCard(item.label, item.advice, "moving");
      });
    } else {
      out += '<p class="gua-wisdom-note">本次沒有動爻，以下以本卦整體智慧作為主要參考。</p>';
    }
    if (changed && currentCast.changed !== currentCast.primary) {
      out += '<div class="gua-wisdom-heading"><strong>變卦人生智慧｜第' +
        changed.number + '卦・' + escapeHtml(changed.name) + '</strong></div>';
      out += wisdomCard("變化後的提醒", changed.summary, "changed");
    }
    out += '<div class="gua-wisdom-conclusion"><strong>綜合思考</strong><p>' +
      escapeHtml(primary.theme[currentCast.moving.length ? currentCast.moving[0]-1 : 0]) +
      '。先理解當下，再依情勢調整；卦象提供思考角度，真正的選擇仍在自己。</p></div>';
    out += '<p class="gua-wisdom-note">警語: 本資料僅供參考。</p>';
    box.innerHTML = out;
  }

  function status(msg) {
    var el = document.getElementById("gua_status");
    if (el) el.textContent = msg || "";
  }

  function hasMarkup(text) {
    return text && text.indexOf("[[") !== -1 && text.indexOf("]]") !== -1;
  }

  function findMarkupElements(root) {
    var result = [];
    var all = (root || document.body).getElementsByTagName("*");
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (SKIP[el.tagName]) continue;
      if (el.id === "gua_status" || el.id === "gua_cast_result") continue;
      var text = el.innerText || el.textContent || "";
      if (!hasMarkup(text)) continue;
      if (el.classList && el.classList.contains("gua-markup")) {
        result.push(el);
        continue;
      }
      var childHas = false;
      for (var j = 0; j < el.children.length; j++) {
        var ct = el.children[j].innerText || el.children[j].textContent || "";
        if (hasMarkup(ct)) { childHas = true; break; }
      }
      if (!childHas) result.push(el);
    }
    return result;
  }

  async function installLocalModule(url, name) {
    try {
      var res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return false;
      var code = await res.text();
      if (!code || !code.trim()) return false;
      pyodide.FS.writeFile(name + ".py", code);
      return true;
    } catch (e) {
      console.warn("change.py 載入失敗", url, e);
      return false;
    }
  }

  async function renderElement(el) {
    var text = el.innerText || el.textContent || "";
    if (!hasMarkup(text)) return;
    pyodide.globals.set("_gua_src", text);
    var html = await pyodide.runPythonAsync(
      "import change\n" +
      "change.render_markup(_gua_src, target_div=None, default_method='html', lang='zh')\n"
    );
    if (html) el.innerHTML = html;
  }

  // ---- 三枚銅錢起卦（JS）----
  // 每次：三幣，字=3 背=2；和 6=老陰 7=少陽 8=少陰 9=老陽
  // 本卦：6/8→陰(0)  7/9→陽(1)；由下往上六爻，再轉成「由上到下」binary 給 change.py
  function castCoins() {
    var linesBottomUp = []; // {val:0|1, moving:bool, coin:6|7|8|9}
    for (var i = 0; i < 6; i++) {
      var s = 0;
      for (var c = 0; c < 3; c++) s += Math.random() < 0.5 ? 2 : 3;
      var val = (s === 7 || s === 9) ? 1 : 0;
      var moving = (s === 6 || s === 9);
      linesBottomUp.push({ val: val, moving: moving, coin: s });
    }
    // binary 上→下
    var primary = "";
    var changed = "";
    var movingIdx = []; // 1=初 … 6=上
    for (var k = 5; k >= 0; k--) {
      primary += String(linesBottomUp[k].val);
      var v = linesBottomUp[k].val;
      if (linesBottomUp[k].moving) {
        v = 1 - v;
        movingIdx.push(k + 1);
      }
      changed += String(v);
    }
    // movingIdx was bottom-up position; convert: bottom idx0=初爻=1
    movingIdx = [];
    for (var m = 0; m < 6; m++) {
      if (linesBottomUp[m].moving) movingIdx.push(m + 1); // 1=初
    }
    return {
      lines: linesBottomUp,
      primary: primary,
      changed: changed,
      moving: movingIdx
    };
  }

  async function doCast() {
    if (!ready || !pyodide) {
      status("元件尚未就緒，請稍候…");
      return;
    }
    var box = document.getElementById("gua_cast_result");
    if (!box) return;
    box.innerHTML = "起卦中…";
    var wisdomBox = document.getElementById("gua_wisdom_result");
    if (wisdomBox) wisdomBox.innerHTML = "";

    var cast = castCoins();
    currentCast = cast;
    var wisdomBtn = document.getElementById("gua_wisdom_btn");
    if (wisdomBtn) wisdomBtn.disabled = !wisdomDB;
    pyodide.globals.set("_bin1", cast.primary);
    pyodide.globals.set("_bin2", cast.changed);
    pyodide.globals.set("_moving", cast.moving.join(","));

    try {
      var resultHtml = await pyodide.runPythonAsync(`
import change
from js import document

b1 = str(_bin1)
b2 = str(_bin2)
moving_s = str(_moving)
moving = [int(x) for x in moving_s.split(",") if x.strip()] if moving_s else []

name1 = change.get_name(b1, lang="zh")
html1 = change.draw(b1, target_div=None, method="html", lang="zh", width=140)

# 簡要卦辭（內建摘要）
INFO = {
"111111": ("乾", "元亨利貞。", "大通而利於守正。剛健中正，自強不息。"),
"000000": ("坤", "元亨，利牝馬之貞。", "柔順承載，安貞則吉。厚德載物。"),
"010001": ("屯", "元亨利貞，勿用有攸往，利建侯。", "始生艱難，宜立根基，勿急進。"),
"100010": ("蒙", "亨。童蒙求我。", "蒙昧待啟，虛心受教則吉。"),
"010111": ("需", "有孚，光亨，貞吉。利涉大川。", "待時而進，有誠則可涉險。"),
"111010": ("訟", "有孚，窒。惕中吉。終凶。", "爭訟宜止，見大人、戒終訟。"),
"000010": ("師", "貞，丈人，吉無咎。", "用眾以正，老成持重則吉。"),
"010000": ("比", "吉。原筮元永貞，無咎。", "親比依附，後夫凶。"),
"110111": ("小畜", "亨。密雲不雨，自我西郊。", "小有積蓄，密雲未雨。"),
"111011": ("履", "履虎尾，不咥人，亨。", "謹慎踐行，可履險而無咎。"),
"000111": ("泰", "小往大來，吉亨。", "天地交泰，通達和順。"),
"111000": ("否", "否之匪人，不利君子貞。", "閉塞不通，君子宜斂德。"),
"111101": ("同人", "同人於野，亨。", "與人和同於公，利涉大川。"),
"101111": ("大有", "元亨。", "大有得，光明普照。"),
"000100": ("謙", "亨，君子有終。", "謙虛不矜，終有善果。"),
"001000": ("豫", "利建侯行師。", "和樂預備，宜立業用眾。"),
"011001": ("隨", "元亨利貞，無咎。", "適時而隨，無有咎害。"),
"100110": ("蠱", "元亨，利涉大川。", "整治弊亂，可涉大難。"),
"000011": ("臨", "元亨利貞。至于八月有凶。", "臨人以正；盛極須戒。"),
"110000": ("觀", "盥而不薦，有孚顒若。", "觀仰與示範，誠意莊嚴。"),
"101001": ("噬嗑", "亨。利用獄。", "咬合除梗，宜於明斷。"),
"100101": ("賁", "亨。小利有攸往。", "文飾之美，小往有利。"),
"100000": ("剝", "不利有攸往。", "剝落之時，不宜有所往。"),
"000001": ("復", "亨。反復其道，七日來復。", "一陽來復，利有攸往。"),
"111001": ("無妄", "元亨利貞。其匪正有眚。", "真實不妄；不正則有災。"),
"100111": ("大畜", "利貞，不家食吉，利涉大川。", "大積蓄，養賢致用。"),
"100001": ("頤", "貞吉。觀頤，自求口實。", "頤養守正，慎言語飲食。"),
"011110": ("大過", "棟橈，利有攸往，亨。", "非常之時，棟梁過重。"),
"010010": ("坎", "習坎，有孚，維心亨。", "重險之中，誠則心通。"),
"101101": ("離", "利貞，亨。畜牝牛，吉。", "附麗光明，柔順則吉。"),
"011100": ("咸", "亨，利貞，取女吉。", "彼此感應，以正則吉。"),
"001110": ("恆", "亨，無咎，利貞，利有攸往。", "恆久守正，利有所往。"),
"111100": ("遯", "亨，小利貞。", "及時退避，小有利貞。"),
"001111": ("大壯", "利貞。", "剛健大壯，宜於守正。"),
"101000": ("晉", "康侯用錫馬蕃庶，晝日三接。", "進而上升，柔順光明。"),
"000101": ("明夷", "利艱貞。", "明傷於下，艱中守正。"),
"110101": ("家人", "利女貞。", "家道以正，女正位乎內。"),
"101011": ("睽", "小事吉。", "乖離之中，宜小事。"),
"010100": ("蹇", "利西南，不利東北；利見大人。", "蹇難，利見大人。"),
"001010": ("解", "利西南，其來復吉。有攸往，夙吉。", "舒解緩難，宜早宜復。"),
"100011": ("損", "有孚，元吉，無咎，可貞。", "減損有誠，可獲大吉。"),
"110001": ("益", "利有攸往，利涉大川。", "增益於下，利於進取。"),
"011111": ("夬", "揚于王庭，孚號，有厲。", "決去陰柔，宜告不宜即戎。"),
"111110": ("姤", "女壯，勿用取女。", "陰遇陽，相遇當慎。"),
"011000": ("萃", "亨。王假有廟，利見大人。", "會聚，利見大人。"),
"000110": ("升", "元亨，用見大人，勿恤，南征吉。", "積小成高，南征吉。"),
"011010": ("困", "亨，貞，大人吉，無咎。", "困中守正，大人吉。"),
"010110": ("井", "改邑不改井。", "井養不窮，修德惠人。"),
"011101": ("革", "己日乃孚。元亨利貞，悔亡。", "變革待時，信而後行。"),
"101110": ("鼎", "元吉，亨。", "鼎新養賢，大吉亨通。"),
"001001": ("震", "亨。震來虩虩，笑言啞啞。", "震動警醒，先懼後安。"),
"100100": ("艮", "艮其背，不獲其身，無咎。", "止於其所，得止無咎。"),
"110100": ("漸", "女歸吉，利貞。", "循序漸進，女歸吉。"),
"001011": ("歸妹", "征凶，無攸利。", "歸嫁失正，征則凶。"),
"001101": ("豐", "亨。王假之，勿憂，宜日中。", "豐盛，宜如日中。"),
"101100": ("旅", "小亨，旅貞吉。", "羈旅在外，守正則吉。"),
"110110": ("巽", "小亨，利有攸往，利見大人。", "遜順申命，利見大人。"),
"011011": ("兌", "亨，利貞。", "喜悅和樂，利於守正。"),
"110010": ("渙", "亨。王假有廟，利涉大川。", "離散可濟，利涉大川。"),
"010011": ("節", "亨。苦節不可貞。", "節制有度，苦節不可久。"),
"110011": ("中孚", "豚魚吉，利涉大川，利貞。", "中心誠信，可感於物。"),
"001100": ("小過", "亨，利貞，可小事，不可大事。", "小過，宜下不宜上。"),
"010101": ("既濟", "亨，小利貞，初吉終亂。", "事已成，慎終防亂。"),
"101010": ("未濟", "亨，小狐汔濟，濡其尾，無攸利。", "未完成，仍有可為之機。"),
}

def info(b):
    return INFO.get(b, (change.get_name(b), "", "請依卦象與處境體會。"))

n1, g1, e1 = info(b1)
parts = []
parts.append("<p><strong>本卦：" + name1 + "</strong></p>")
parts.append(html1)
parts.append("<p><em>卦辭：</em>" + g1 + "</p>")
parts.append("<p><em>大意：</em>" + e1 + "</p>")

labels = ["初", "二", "三", "四", "五", "上"]
# lines bottom-up from binary: b1 is top-to-bottom
line_txt = []
for i, ch in enumerate(reversed(b1)):
    lab = labels[i]
    kind = "陽" if ch == "1" else "陰"
    mov = "（動）" if (i + 1) in moving else ""
    line_txt.append(lab + "爻 " + kind + mov)
parts.append("<p class='lines'>" + "\\n".join(line_txt) + "</p>")

if moving and b2 != b1:
    name2 = change.get_name(b2, lang="zh")
    html2 = change.draw(b2, target_div=None, method="html", lang="zh", width=140)
    n2, g2, e2 = info(b2)
    parts.append("<hr><p><strong>之卦（變卦）：" + name2 + "</strong></p>")
    parts.append("<p>動爻：" + "、".join(labels[i-1] for i in moving) + "</p>")
    parts.append(html2)
    parts.append("<p><em>卦辭：</em>" + g2 + "</p>")
    parts.append("<p><em>大意：</em>" + e2 + "</p>")
else:
    parts.append("<p>（無動爻，或動後仍同卦）</p>")

parts.append("<p style='font-size:13px;color:#666;'>說明：內容僅供參考。</p>")
"".join(parts)
`);
      box.innerHTML = resultHtml;
      status("");
    } catch (e) {
      box.innerHTML = "卜卦失敗：" + e;
      console.error(e);
    }
  }

  async function main() {
    if (!document.body) {
      setTimeout(main, 100);
      return;
    }

    if (typeof loadPyodide !== "function") {
      status("Pyodide 尚未載入…");
      setTimeout(main, 400);
      return;
    }

    status("載入卦象元件與人生智慧資料…");
    var wisdomReady = await loadWisdom();
    try {
      pyodide = await loadPyodide();
    } catch (e) {
      status("Pyodide 失敗：" + e);
      return;
    }

    var ok =
      (await installLocalModule("/static/change.py", "change")) ||
      (await installLocalModule("/downloads/change.py", "change")) ||
      (await installLocalModule("./../static/change.py", "change")) ||
      (await installLocalModule("./../downloads/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    ready = true;
    status("");

    // 綁定卜卦按鈕
    var btn = document.getElementById("gua_cast_btn");
    if (btn) btn.onclick = function () { doCast(); };
    var wisdomBtn = document.getElementById("gua_wisdom_btn");
    if (wisdomBtn) {
      wisdomBtn.disabled = !wisdomReady;
      wisdomBtn.onclick = function () { showWisdom(); };
    }
    if (!wisdomReady) status("卦象已就緒；人生智慧資料未載入，請確認 wisdom.json 已放入 /static/ 或 /downloads/。");
    var clr = document.getElementById("gua_cast_clear");
    if (clr) clr.onclick = function () {
      var box = document.getElementById("gua_cast_result");
      if (box) box.innerHTML = "";
      var wb = document.getElementById("gua_wisdom_result");
      if (wb) wb.innerHTML = "";
      currentCast = null;
      var wbtn = document.getElementById("gua_wisdom_btn");
      if (wbtn) wbtn.disabled = true;
    };

    // 原有標記渲染
    try {
      var targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(targets[i]);
      }
    } catch (e) {
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
</script>
<h2>八宮分類</h2>


















<p class="meta">第一層：八宮。</p>
<p class="meta">第二層：每宮四組（本宮與一世、二世與三世、四世與五世、游魂與歸魂）。</p>
<p class="meta">第三層：單卦詳頁（意義與象徵請自行補充）。</p>
<p class="meta">乾宮 （金）qian<br>震宮 （木）zhen<br>坎宮 （水）kan<br>艮宮 （土）gen<br>坤宮 （土）kun<br>巽宮 （木）xun<br>離宮 （火）li<br>兌宮 （金）dui<br><br>京房八宮分類 · 三層架構（宮 → 四組 → 單卦）</p>
<h4>易經「八宮」分類法是什麼？</h4>
<p><strong>八宮</strong>是把六十四卦收成 <strong>八個「家族」</strong> 的系統：每一宮以一個<strong>八純卦</strong>（上下卦相同）為「宮主」，再依固定的<strong>爻變規則</strong>推出另外七卦，合起來每宮八卦，八宮剛好六十四卦，一卦不漏、一卦不重。</p>
<p>每宮內的八個位置固定叫：</p>
<table>
<thead>
<tr>
<th>順序</th>
<th>名稱</th>
<th>大致意思</th>
</tr>
</thead>
<tbody>
<tr>
<td>1</td>
<td><strong>本宮</strong></td>
<td>宮主本身（純卦）</td>
</tr>
<tr>
<td>2～6</td>
<td><strong>一世～五世</strong></td>
<td>由下往上逐爻變來</td>
</tr>
<tr>
<td>7</td>
<td><strong>游魂</strong></td>
<td>五世之後，第四爻「回頭」再變</td>
</tr>
<tr>
<td>8</td>
<td><strong>歸魂</strong></td>
<td>游魂之後，下卦三爻整組變回接近本宮</td>
</tr>
</tbody>
</table>
<p>例如乾宮：</p>
<p>乾為天（本宮）→ 天風姤（一世）→ 天山遯（二世）→ 天地否（三世）→ 風地觀（四世）→ 山地剝（五世）→ 火地晉（游魂）→ 火天大有（歸魂）</p>
<p>震、坎、艮、坤、巽、離、兌各宮，規則相同，只是起點的純卦不同。</p>
<hr>
<h4>誰發明的？</h4>
<p>一般歸於西漢易學家<strong>京房</strong>（字君明，約西元前 77–37 年）。</p>
<ul>
<li>師承梁人焦延壽，屬漢代「象數易」一脈。</li>
<li>相關說法見《<a href="https://upload.wikimedia.org/wikipedia/commons/1/1b/CNTS-00109622467_%E4%BA%AC%E6%B0%8F%E6%98%93%E5%82%B3.pdf">京氏易傳</a>》及後世所傳京氏學。</li>
<li>不只排卦序，還把<strong>八宮</strong>和<strong>納甲、世應、六親、五行</strong>等合在一起，成為後來「火珠林」「六爻納甲」占法的骨架。</li>
</ul>
<p>因此：八宮不是《周易》經文原本的編次（經文是文王卦序），而是<strong>漢代為占斷與氣數而重排的系統</strong>。</p>
<hr>
<h4>為何要這樣分類？</h4>
<p>可以從三個層次看：</p>
<h4>1. 方法上：要有「可推演的規則」</h4>
<p>若只按經文 1～64 背卦名，占筮時很難快速判斷「這一卦在整盤裡的角色」。<br> 京房用「從本宮往下逐爻變」的機械規則，讓：</p>
<ul>
<li>任意一卦都能歸進某一宮；</li>
<li>宮內位置（世幾、游魂、歸魂）可定；</li>
<li>再配合世爻、應爻，主客關係就有著落。</li>
</ul>
<h4>2. 思想上：氣的盛衰與「往而復」</h4>
<p>一世→五世，像一股氣由內（下）往外（上）展開；<br> 到五世後不繼續變上爻，而讓第四爻「回來」，再讓下卦回歸，形成：</p>
<ul>
<li><strong>游魂</strong>：氣已離本位、尚在外遊；</li>
<li><strong>歸魂</strong>：氣回近本宮、有「歸」之象。</li>
</ul>
<p>這和《繫辭》(<a href="https://zh.wikisource.org/zh-hant/%E6%98%93%E5%82%B3/%E7%B9%AB%E8%BE%AD%E4%B8%8A">上</a>、<a href="https://zh.wikisource.org/zh-hant/%E6%98%93%E5%82%B3/%E7%B9%AB%E8%BE%AD%E4%B8%8B">下</a>)「精氣為物，游魂為變」的說法被後人連在一起，用來談人事的離合、往來、未定與落定。</p>
<h4>3. 實務上：服務納甲占卜</h4>
<p>八宮為每卦定了：</p>
<ul>
<li><strong>宮的五行</strong>（如乾宮金、坎宮水）——論六親時「以宮為我」；</li>
<li><strong>世爻位置</strong>——本宮世在上爻、一世世在初爻……有固定表；</li>
<li><strong>游魂／歸魂</strong>——占出行、歸鄉、尋人、心神不定等時特別好用。</li>
</ul>
<p>沒有八宮，後面的裝卦、六親、飛伏會少一個總綱。</p>
<hr>
<h4>如何應用？</h4>
<h4>（一）查「這一卦屬於哪一宮、第幾世」</h4>
<p>得到本卦後，先查八宮表，知道：</p>
<ul>
<li>屬哪一宮 → 宮五行（論生剋、六親）；</li>
<li>是本宮／几世／游魂／歸魂 → 事的「階段感」（初起、展開、將盡、外遊、將歸）。</li>
</ul>
<h4>（二）定世應</h4>
<ul>
<li><strong>世爻</strong>：事主、自己、問事的主體；</li>
<li><strong>應爻</strong>：與世相對的一方（他人、對象、環境）。</li>
</ul>
<p>世應位置由「宮內第幾卦」決定，不必每次重推。</p>
<h4>（三）游魂、歸魂的常見用法（示意，非絕對）</h4>
<table>
<thead>
<tr>
<th>類型</th>
<th>常聯想的事象</th>
</tr>
</thead>
<tbody>
<tr>
<td>游魂</td>
<td>在外、未定、遷徙、心神遊移、暫時未歸</td>
</tr>
<tr>
<td>歸魂</td>
<td>回歸、了結、回鄉、舊事重來、歸於本位</td>
</tr>
</tbody>
</table>
<p>仍須合動爻、用神、月日，不能單憑游歸斷死。</p>
<h4>（四）和「三層網頁」的對應（你目前的架構）</h4>
<table>
<thead>
<tr>
<th>網頁層</th>
<th>八宮概念</th>
</tr>
</thead>
<tbody>
<tr>
<td>第一層 h1</td>
<td>八宮（乾宮、震宮…）</td>
</tr>
<tr>
<td>第二層 h2</td>
<td>每宮四組：本宮一世／二三／四五／游歸</td>
</tr>
<tr>
<td>第三層 h3／詳頁</td>
<td>單卦：意義、象徵、應用</td>
</tr>
</tbody>
</table>
<p>這樣分類<strong>有歷史與占法依據</strong>，不是任意切 8×4×2；讀者由「宮 → 氣的階段 → 單卦」往下讀，脈絡會清楚。</p>
<h4>（五）學習與寫作時建議</h4>
<ol>
<li><strong>先記八個本宮</strong>（八純卦）與每宮五行。</li>
<li><strong>再記變爻順序</strong>（初→五，再游、歸），能自己推一宮就不必死背 64。</li>
<li><strong>詳頁</strong>寫卦辭、象、引申時，可加一句「某宮之几世／游魂／歸魂」，方便和六爻體系對接。</li>
<li>若內容偏「經文哲理」而非占筮，仍可用八宮做<strong>導覽目錄</strong>，但正文以卦辭、大象為主，避免把漢代占法說成孔子原意。</li>
</ol>
<hr>
<h4>簡要對照</h4>
<table>
<thead>
<tr>
<th>項目</th>
<th>說明</th>
</tr>
</thead>
<tbody>
<tr>
<td>是什麼</td>
<td>六十四卦分為八宮，每宮八卦（本宮＋五世＋游魂＋歸魂）</td>
</tr>
<tr>
<td>誰提出</td>
<td>西漢京房（京氏易）</td>
</tr>
<tr>
<td>為何分</td>
<td>便於推演、表氣之往復、支撐納甲／世應／六親占法</td>
</tr>
<tr>
<td>如何用</td>
<td>定宮與五行、定世應、看游歸、作系統化學習與網站分層</td>
</tr>
</tbody>
</table>
<p>八宮是<strong>漢代象數易的操作系統</strong>；《周易》經傳是更早的文本。兩者可以並用：經文講義理，八宮講結構與占法定位。</p>
<h4>易經八宮完整分類表（京房）</h4>
<p>說明：每宮 8 卦，順序為 <strong>本宮 → 一世 → 二世 → 三世 → 四世 → 五世 → 游魂 → 歸魂</strong>。<br> 卦名採常見全稱；括號內為文王卦序。</p>
