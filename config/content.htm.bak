      var childHas = false;
      for (var j = 0; j < el.children.length; j++) {
        var ct = el.children[j].innerText || el.children[j].textContent || "";
        if (hasMarkup(ct)) { childHas = true; break; }
      }
      if (!childHas) result.push(el);
    }
    return result;
  }

  async function installLocalModule(pyodide, url, name) {
    try {
      var res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return false;
      var code = await res.text();
      if (!code || !code.trim()) return false;
      pyodide.FS.writeFile(name + ".py", code);
      return true;
    } catch (e) {
      console.warn("change.py 載入失敗", url, e);
      return false;
    }
  }

  async function renderElement(pyodide, el) {
    var text = el.innerText || el.textContent || "";
    if (!hasMarkup(text)) return;
    pyodide.globals.set("_gua_src", text);
    var html = await pyodide.runPythonAsync(
      "import change\n" +
      "change.render_markup(_gua_src, target_div=None, default_method='html', lang='zh')\n"
    );
    if (html) el.innerHTML = html;
  }

  async function main() {
    if (!document.body) {
      setTimeout(main, 100);
      return;
    }

    var targets = findMarkupElements(document.body);
    if (targets.length === 0) {
      // 內容可能稍後才出現（ViewPage 動態載入）
      if (!main._tries) main._tries = 0;
      if (main._tries++ < 20) {
        setTimeout(main, 300);
      }
      return;
    }

    if (typeof loadPyodide !== "function") {
      status("Pyodide 尚未載入…");
      setTimeout(main, 400);
      return;
    }

    status("載入卦象元件…");
    var pyodide;
    try {
      pyodide = await loadPyodide();
    } catch (e) {
      status("Pyodide 失敗：" + e);
      return;
    }

    var ok =
      (await installLocalModule(pyodide, "/static/change.py", "change")) ||
      (await installLocalModule(pyodide, "/downloads/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../static/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../downloads/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    try {
      targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(pyodide, targets[i]);
      }
      status("");
    } catch (e) {
      status("渲染失敗：" + e);
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
// ]]></script>
<h1>震木</h1>


































<p class="meta">本宮統八卦，依世變為一世至五世，再為游魂、歸魂。下列四組為第二層分類。</p>
<p class="meta">[[震]]</p>
<p>震卦之所以稱為「木」，主要是因為震卦代表雷、震動、萌發、生長與春天的力量，這些特性與五行之木所代表的生發、成長、向上突破的性質相符合。</p>
<p>與乾卦屬金的道理類似，震卦原本代表的是「雷」，而不是樹木；震屬木，是八卦與五行結合後的分類。</p>
<p>不過，震卦與木之間的關係，比單純的象徵對應更有意思。</p>
<h4>一、震卦的基本卦象</h4>
<p><br></p>
<p>震卦的符號是：</p>
<h4>☳ 震卦</h4>
<h4>━━━</h4>
<h4>━　━</h4>
<h4>━　━</h4>
<p>初爻為陽，上面兩爻為陰</p>
<p>震卦的三爻結構：</p>
<ul>
<li>初爻：陽爻，代表力量開始發動。</li>
<li>二爻：陰爻，代表尚未充分展開。</li>
<li>三爻：陰爻，代表力量仍在發展過程。</li>
</ul>
<p>這個卦象可以理解成：原本安靜的狀態，底部突然產生一股強大的力量，向上推動。</p>
<p>這正好符合春天萬物從土壤中萌芽的現象。</p>
<p>《說卦傳》說：</p>
<blockquote>
<p>震為雷，為龍，為玄黃，為旉，為大塗，為長子……</p>
</blockquote>
<p>其中「震為雷」是震卦最基本的象徵。</p>
<h4>二、為什麼雷可以代表木？</h4>
<p>這是理解震卦屬木的核心。</p>
<p>可以從自然界的四個現象來理解。</p>
<p>1. 萌芽：由內而外的力量</p>
<p>種子在土壤中累積能量，到了適當時機便突破土壤，向上生長。震卦初爻的陽氣發動，就像種子萌芽。</p>
<p>2. 雷動：打破原本的安靜</p>
<p>春雷響起，代表季節轉換，大地開始活躍。震卦的震動象徵生命力量開始運作。</p>
<p>3. 生長：向上與向外擴展</p>
<p>木的五行特性是生發、條達、向上。震卦代表事物開始發展，與木的性質相通。</p>
<p>4. 春天：萬物開始生長</p>
<p>五行之木對應春季，而震卦在後天八卦中位於正東，正是太陽升起、陽氣開始增長的方向。</p>
<p>因此，震卦與木的共同特性可以歸納為：</p>
<p>啟動、突破、萌發、生長、擴張。</p>
<h4>三、震卦為什麼位於東方？</h4>
<p>在後天八卦中，震卦位於正東。</p>
<table>
<thead>
<tr>
<th>項目</th>
<th>震卦</th>
</tr>
</thead>
<tbody>
<tr>
<td>卦象</td>
<td>☳</td>
</tr>
<tr>
<td>自然象徵</td>
<td>雷</td>
</tr>
<tr>
<td>方位</td>
<td>正東</td>
</tr>
<tr>
<td>五行</td>
<td>木</td>
</tr>
<tr>
<td>季節</td>
<td>春</td>
</tr>
<tr>
<td>家庭</td>
<td>長男</td>
</tr>
<tr>
<td>身體</td>
<td>足</td>
</tr>
<tr>
<td>顏色（常見五行象義）</td>
<td>青、綠</td>
</tr>
<tr>
<td>先天數</td>
<td>四</td>
</tr>
<tr>
<td>後天數</td>
<td>三</td>
</tr>
</tbody>
</table>
<p>為什麼東方屬木？</p>
<p>傳統五行觀念中：</p>
<ul>
<li>東方是日出方向。</li>
<li>日出代表陽氣開始增長。</li>
<li>春季是植物萌芽、生長的季節。</li>
<li>木代表生命的生發力量。</li>
</ul>
<p>所以東方、春天、木與震卦便形成一組相互對應的象徵系統。</p>
<h4>四、為什麼震卦只有第一爻是陽爻？</h4>
<p>這是非常值得研究的地方。</p>
<p>我們將震卦與其他卦比較：</p>
<p>震卦 ☳</p>
<h4>━━━</h4>
<h4>━　━</h4>
<h4>━　━</h4>
<p>一陽在下</p>
<p>陽氣從底部開始發動，象徵萌芽與啟動。</p>
<p>巽卦 ☴</p>
<h4>━　━</h4>
<h4>━　━</h4>
<h4>━━━</h4>
<p>一陽在上</p>
<p>一陽居於上方，象徵風的進入、滲透與順應。</p>
<p>震與巽都屬木，但兩者的木性有所不同：</p>
<table>
<thead>
<tr>
<th>比較</th>
<th>震卦</th>
<th>巽卦</th>
</tr>
</thead>
<tbody>
<tr>
<td>五行</td>
<td>陽木</td>
<td>陰木</td>
</tr>
<tr>
<td>自然</td>
<td>雷</td>
<td>風</td>
</tr>
<tr>
<td>方位</td>
<td>東</td>
<td>東南</td>
</tr>
<tr>
<td>性質</td>
<td>發動、突破</td>
<td>滲透、柔順</td>
</tr>
<tr>
<td>象徵</td>
<td>大樹、向上生長</td>
<td>花草、藤蔓、枝葉</td>
</tr>
<tr>
<td>家庭</td>
<td>長男</td>
<td>長女</td>
</tr>
</tbody>
</table>
<p>這裡的陽木、陰木是傳統象義的延伸解釋，不是《說卦傳》對兩卦直接下的定義。</p>
<h4>五、八卦與五行的完整對照</h4>
<p>現在把乾卦與震卦放在整個八卦系統中，就更容易理解了。</p>
<table>
<thead>
<tr>
<th>八卦</th>
<th>卦象</th>
<th>自然</th>
<th>五行</th>
<th>方位</th>
</tr>
</thead>
<tbody>
<tr>
<td>乾</td>
<td>☰</td>
<td>天</td>
<td>金</td>
<td>西北</td>
</tr>
<tr>
<td>兌</td>
<td>☱</td>
<td>澤</td>
<td>金</td>
<td>西</td>
</tr>
<tr>
<td>離</td>
<td>☲</td>
<td>火</td>
<td>火</td>
<td>南</td>
</tr>
<tr>
<td>震</td>
<td>☳</td>
<td>雷</td>
<td>木</td>
<td>東</td>
</tr>
<tr>
<td>巽</td>
<td>☴</td>
<td>風</td>
<td>木</td>
<td>東南</td>
</tr>
<tr>
<td>坎</td>
<td>☵</td>
<td>水</td>
<td>水</td>
<td>北</td>
</tr>
<tr>
<td>艮</td>
<td>☶</td>
<td>山</td>
<td>土</td>
<td>東北</td>
</tr>
<tr>
<td>坤</td>
<td>☷</td>
<td>地</td>
<td>土</td>
<td>西南</td>
</tr>
</tbody>
</table>
<p>這個系統可以用五行的運行概念來理解：</p>
<p>五行相生：</p>
<p>木 → 火 → 土 → 金 → 水 → 木</p>
<p>八卦與五行的對應，則是把自然界的不同現象，放進這個五行運行系統中。</p>
<h4>六、從乾卦與震卦看《易經》的深層思想</h4>
<p>我們可以將前面討論的乾卦與現在的震卦放在一起比較：</p>
<table>
<thead>
<tr>
<th>比較</th>
<th>乾卦</th>
<th>震卦</th>
</tr>
</thead>
<tbody>
<tr>
<td>五行</td>
<td>金</td>
<td>木</td>
</tr>
<tr>
<td>自然</td>
<td>天</td>
<td>雷</td>
</tr>
<tr>
<td>陰陽</td>
<td>三陽</td>
<td>一陽二陰</td>
</tr>
<tr>
<td>核心力量</td>
<td>創造、主導</td>
<td>啟動、萌發</td>
</tr>
<tr>
<td>代表方位</td>
<td>西北</td>
<td>東</td>
</tr>
<tr>
<td>代表季節意象</td>
<td>秋冬之交</td>
<td>春</td>
</tr>
<tr>
<td>象徵精神</td>
<td>自強不息</td>
<td>奮起行動</td>
</tr>
</tbody>
</table>
<p>我認為理解這兩卦時，最值得掌握的是：</p>
<ul>
<li>乾卦代表宇宙運行的剛健力量。</li>
<li>震卦代表生命開始發動的力量。</li>
</ul>
<p>乾是天道的創造與主導，震是萬物受到陽氣推動而開始生長。</p>
<p>這也解釋了為什麼《易經》不只是占卜系統，更是一套觀察自然、生命、陰陽變化與事物發展的哲學體系。</p>
<p>
<script src="https://cdn.jsdelivr.net/pyodide/v0.27.0/full/pyodide.js"></script>
<script>
(function () {
  "use strict";

  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, CODE: 1, PRE: 1 };

  function status(msg) {
    var el = document.getElementById("gua_status");
    if (el) el.textContent = msg || "";
  }

  function hasMarkup(text) {
    return text && text.indexOf("[[") !== -1 && text.indexOf("]]") !== -1;
  }

  /** 找出含 [[...]] 且適合替換的元素（略過 script/style 等） */
  function findMarkupElements(root) {
    var result = [];
    var all = (root || document.body).getElementsByTagName("*");
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (SKIP[el.tagName]) continue;
      if (el.id === "gua_status") continue;
      // 只處理「自身有文字、且子元素沒有再包一層含標記的容器」的節點，
      // 或明確標了 class="gua-markup"
      var text = el.innerText || el.textContent || "";
      if (!hasMarkup(text)) continue;
      if (el.classList && el.classList.contains("gua-markup")) {
        result.push(el);
        continue;
      }
      // 若子元素也有標記，交給子元素處理，避免重複
      var childHas = false;
      for (var j = 0; j < el.children.length; j++) {
        var ct = el.children[j].innerText || el.children[j].textContent || "";
        if (hasMarkup(ct)) { childHas = true; break; }
      }
      if (!childHas) result.push(el);
    }
    return result;
  }

  async function installLocalModule(pyodide, url, name) {
    try {
      var res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return false;
      var code = await res.text();
      if (!code || !code.trim()) return false;
      pyodide.FS.writeFile(name + ".py", code);
      return true;
    } catch (e) {
      console.warn("change.py 載入失敗", url, e);
      return false;
    }
  }

  async function renderElement(pyodide, el) {
    var text = el.innerText || el.textContent || "";
    if (!hasMarkup(text)) return;
    pyodide.globals.set("_gua_src", text);
    var html = await pyodide.runPythonAsync(
      "import change\n" +
      "change.render_markup(_gua_src, target_div=None, default_method='html', lang='zh')\n"
    );
    if (html) el.innerHTML = html;
  }

  async function main() {
    if (!document.body) {
      setTimeout(main, 100);
      return;
    }

    var targets = findMarkupElements(document.body);
    if (targets.length === 0) {
      // 內容可能稍後才出現（ViewPage 動態載入）
      if (!main._tries) main._tries = 0;
      if (main._tries++ < 20) {
        setTimeout(main, 300);
      }
      return;
    }

    if (typeof loadPyodide !== "function") {
      status("Pyodide 尚未載入…");
      setTimeout(main, 400);
      return;
    }

    status("載入卦象元件…");
    var pyodide;
    try {
      pyodide = await loadPyodide();
    } catch (e) {
      status("Pyodide 失敗：" + e);
      return;
    }

    var ok =
      (await installLocalModule(pyodide, "/static/change.py", "change")) ||
      (await installLocalModule(pyodide, "/downloads/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../static/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../downloads/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    try {
      targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(pyodide, targets[i]);
      }
      status("");
    } catch (e) {
      status("渲染失敗：" + e);
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
</script>
</p>
<h2>本宮與一世-1</h2>














































<ul class="plain">
<li>
<h3>本宮 · 震為雷</h3>














































<p>（文王第 51 卦） · <a href="../gua/51_震.html">詳頁</a> · 標記 [[ 震 ]]</p>
