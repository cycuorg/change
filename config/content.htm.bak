<script>// <![CDATA[
function getUrlParam(key) {
  return new URLSearchParams(window.location.search).get(key);
}
function updateUrlParam(key, value) {
  const url = new URL(window.location);
  url.searchParams.set(key, value);
  window.history.replaceState({}, "", url);
}
let pyodide, editor1, editor2;

/* 兩個編輯器共用一個 Pyodide 與 sys.stdout/stderr，執行工作必須排隊。 */
let pyodideRunQueue = Promise.resolve();
function enqueuePyodideRun(task) {
  const next = pyodideRunQueue.then(task, task);
  pyodideRunQueue = next.catch(() => {});
  return next;
}

document.addEventListener("DOMContentLoaded", async () => {
  try {
    editor1 = ace.edit("kw_editor1");
    editor1.setTheme("ace/theme/chrome");
    editor1.session.setMode("ace/mode/python");
    editor2 = ace.edit("kw_editor2");
    editor2.setTheme("ace/theme/chrome");
    editor2.session.setMode("ace/mode/python");

    pyodide = await loadPyodide();
    await pyodide.loadPackage(["numpy", "scipy", "matplotlib", "micropip"]);

    // ===== 安全安裝 robot 模組：失敗不中斷整頁 =====
    async function installLocalModule(url, moduleName) {
      try {
        const res = await fetch(url, { cache: "no-store" });
        if (!res.ok) {
          console.warn("模組載入失敗 (HTTP " + res.status + "):", url);
          return false;
        }
        const code = await res.text();
        if (!code || !code.trim()) {
          console.warn("模組內容為空:", url);
          return false;
        }
        pyodide.FS.writeFile(moduleName + ".py", code);
        console.log("已安裝模組:", moduleName, "←", url);
        return true;
      } catch (e) {
        console.warn("模組載入例外:", url, e);
        return false;
      }
    }
    try {
      const ok =
        (await installLocalModule("/static/robot.py", "robot")) ||
        (await installLocalModule("/downloads/robot.py", "robot"));
        (await installLocalModule("/static/change.py", "change")) ||
        (await installLocalModule("/downloads/change.py", "change"));
        // 以下針對網頁下有目錄導入程式庫
        (await installLocalModule("./../static/robot.py", "robot")) ||
        (await installLocalModule("./../downloads/robot.py", "robot"));
        (await installLocalModule("./../static/change.py", "change")) ||
        (await installLocalModule("./../downloads/change.py", "change"));
      if (!ok) console.warn("robot 模組未安裝（/static 與 /downloads 都失敗）。其餘功能仍可使用。");
    } catch (e) {
      console.warn("install robot 略過:", e);
    }

    const code = `
def hello():
    print("Hello from custom module! (模組定義寫在本網頁中)")
`;
    pyodide.runPython(code);

    const GIST_ADD1TO100 =
      "https://gist.githubusercontent.com/mdecourse/0229a8a017091476a79700b8a190f185/raw/" +
      "c48e37714f055c3a0027cbfef59e442a6ef659b9/from_1_add_to_100_1.py";
    const NUMPY_ODE =
      "https://gist.githubusercontent.com/mdecycu/ec4bb35dd0769e7a83d2a9fa57878a67/raw/" +
      "98d582539545b3c9fbfa35dd3e605c506367618e/pyodide_ode_ex1.py";
    const PYODIDE_ROBOT_ANIMATION =
      "https://gist.githubusercontent.com/mdecycu/ec4bb35dd0769e7a83d2a9fa57878a67/raw/" +
      "9d164526e5f0fedbdcab913cb8bb180c0cb462a8/pyodide_robot_ex1.py";
    const FREE_WALK =
      "https://gist.githubusercontent.com/mdecycu/ec4bb35dd0769e7a83d2a9fa57878a67/raw/" +
      "8655bed2bf5c8dfa6e6d776d7b09264f1ed23d47/pyodide_robot_ex3.py";

    const src = getUrlParam("src");
    if (src === PYODIDE_ROBOT_ANIMATION) {
      const robotCode = await fetchCode(PYODIDE_ROBOT_ANIMATION);
      editor1.setValue(robotCode, -1);
      updateUrlParam("src", PYODIDE_ROBOT_ANIMATION);
      await runPyodide(editor1, "kw_console1", "brython_div1");
    } else {
      const initialCode = await fetchCode(src || GIST_ADD1TO100);
      editor1.setValue(initialCode, -1);
      await runPyodide(editor1, "kw_console1", "brython_div1");
    }
    editor2.setValue("", -1);

    document.getElementById("version").onclick = () => {
      const vcode = `
import pyodide
import sys
import matplotlib
import numpy
import scipy
print("Pyodide version:", pyodide.__version__)
print("Python version :", sys.version)
print("matplotlib version:", matplotlib.__version__)
print("numpy version:", numpy.__version__)
print("scipy version:", scipy.__version__)
`;
      editor1.setValue(vcode, -1);
      updateUrlParam("src", "inline_version");
      runPyodide(editor1, "kw_console1", "brython_div1");
    };
    document.getElementById("hello_button").onclick = () => {
      editor1.setValue("hello()", -1);
      updateUrlParam("src", "inline_hello");
      runPyodide(editor1, "kw_console1", "brython_div1");
    };
    document.getElementById("add1to100").onclick = async () => {
      const c = await fetchCode(GIST_ADD1TO100);
      editor1.setValue(c, -1);
      updateUrlParam("src", GIST_ADD1TO100);
      await runPyodide(editor1, "kw_console1", "brython_div1");
    };
    document.getElementById("numpy_ode").onclick = async () => {
      const c = await fetchCode(NUMPY_ODE);
      editor1.setValue(c, -1);
      updateUrlParam("src", NUMPY_ODE);
      await runPyodide(editor1, "kw_console1", "brython_div1");
    };
    document.getElementById("robot1").onclick = async () => {
      const rc = await fetchCode(PYODIDE_ROBOT_ANIMATION);
      editor1.setValue(rc, -1);
      updateUrlParam("src", PYODIDE_ROBOT_ANIMATION);
      await runPyodide(editor1, "kw_console1", "brython_div1");
    };
    document.getElementById("free_walk").onclick = async () => {
      const rc = await fetchCode(FREE_WALK);
      editor1.setValue(rc, -1);
      updateUrlParam("src", FREE_WALK);
      await runPyodide(editor1, "kw_console1", "brython_div1");
    };
    document.getElementById("add1to100part2").onclick = async () => {
      const c = await fetchCode(GIST_ADD1TO100);
      editor2.setValue(c, -1);
      await runPyodide(editor2, "kw_console2", "brython_div2");
    };
    document.getElementById("kw_run1").onclick = () =>
      runPyodide(editor1, "kw_console1", "brython_div1");
    document.getElementById("kw_run2").onclick = () =>
      runPyodide(editor2, "kw_console2", "brython_div2");
    document.getElementById("kw_clear_console1").onclick = () =>
      clearOutput("kw_console1", "brython_div1");
    document.getElementById("kw_clear_console2").onclick = () =>
      clearOutput("kw_console2", "brython_div2");
    document.getElementById("kw_output1").onclick = () => {
      const ta = document.getElementById("kw_console1");
      ta.rows = "15";
      ta.cols = "70";
      ta.scrollTop = 0;
    };
    document.getElementById("kw_output2").onclick = () => {
      const ta = document.getElementById("kw_console2");
      ta.rows = "15";
      ta.cols = "70";
      ta.scrollTop = 0;
    };
  } catch (e) {
    console.error("Pyodide 初始化失敗：", e);
    const ta = document.getElementById("kw_console1");
    if (ta) ta.value += "\n初始化錯誤：" + (e.message || e.toString());
  }
});

async function fetchCode(url) {
  const r = await fetch(url);
  if (!r.ok) throw new Error("載入失敗 " + r.status);
  return await r.text();
}
function clearOutput(consoleId, divId) {
  document.getElementById(consoleId).value = "";
  document.getElementById(divId).innerHTML = "";
}

/* 把清除、writer 設定、Python 執行、錯誤處理整體放進佇列。 */
async function runPyodide(editor, consoleId, divId) {
  return enqueuePyodideRun(async () => {
    if (!pyodide) {
      document.getElementById(consoleId).value += "Pyodide 尚未初始化完成。\n";
      return;
    }
    const output = document.getElementById(consoleId);
    const visual = document.getElementById(divId);
    output.value = "";
    visual.innerHTML = "";

    await pyodide.runPythonAsync(`
import sys
class JsWriter:
  def write(self, s):
    from js import document
    ta = document.getElementById("${consoleId}")
    ta.value += s
    ta.scrollTop = ta.scrollHeight
  def flush(self):
    pass
sys.stdout = JsWriter()
sys.stderr = JsWriter()
`);
    try {
      await pyodide.runPythonAsync(editor.getValue());
    } catch (e) {
      output.value += "\n錯誤：" + (e.message || e.toString());
      output.scrollTop = output.scrollHeight;
    }
  });
}
// ]]></script>
</p>
<h1>乾金</h1>






<p class="meta">本宮統八卦，依世變為一世至五世，再為游魂、歸魂。下列四組為第二層分類。</p>
<p class="meta">[[乾]]</p>
<p>在《易經》的八卦體系中，乾卦之所以稱為「金」，主要是因為後世將八卦與五行結合，並透過乾卦所代表的天、陽剛、權威、堅強等特性，將它歸類於金的五行屬性。</p>
<p>不過，這裡有一個值得深入理解的地方：乾卦原本並不是金，而是代表「天」。乾屬金，是八卦與五行配合之後形成的分類。</p>
<p>以下從幾個層次說明。</p>
<h4>一、乾卦原本代表什麼？</h4>
<p>乾卦的卦象是：</p>
<p>[[乾]]</p>
<p>三條陽爻，沒有陰爻</p>
<p>乾卦的基本象徵：</p>
<table>
<thead>
<tr>
<th>項目</th>
<th>乾卦代表</th>
</tr>
</thead>
<tbody>
<tr>
<td>卦象</td>
<td>☰</td>
</tr>
<tr>
<td>自然</td>
<td>天</td>
</tr>
<tr>
<td>五行</td>
<td>金</td>
</tr>
<tr>
<td>方位（後天八卦）</td>
<td>西北</td>
</tr>
<tr>
<td>季節</td>
<td>秋冬之交</td>
</tr>
<tr>
<td>家庭</td>
<td>父親</td>
</tr>
<tr>
<td>身體</td>
<td>頭部</td>
</tr>
<tr>
<td>性質</td>
<td>剛健、主動、創造</td>
</tr>
<tr>
<td>數字（先天）</td>
<td>一</td>
</tr>
<tr>
<td>數字（後天）</td>
<td>六</td>
</tr>
</tbody>
</table>
<p>《說卦傳》對乾卦有一句非常重要的描述：</p>
<blockquote>
<p>乾為天，為圓，為君，為父，為玉，為金，為寒，為冰。</p>
</blockquote>
<p>這裡已經直接將乾與金連結起來。</p>
<h4>二、為什麼乾卦具有金的特性？</h4>
<p>可以從三個角度理解。</p>
<p>1. 乾卦的陽剛特性與金相通</p>
<p>乾卦由三個陽爻構成，代表純陽。</p>
<p>陽的特性包括：</p>
<ul>
<li>堅強、有力量。</li>
<li>主動、具有推動能力。</li>
<li>剛健、不容易屈服。</li>
<li>具有領導與統御能力。</li>
</ul>
<p>金在五行中的象徵也具有堅硬、剛強、收斂、果斷等特質。</p>
<p>因此，乾卦的純陽剛健與金的性質有相通之處。</p>
<p>2. 金代表秋天的肅殺與收斂</p>
<p>五行與季節的關係：</p>
<table>
<thead>
<tr>
<th>五行</th>
<th>季節</th>
<th>主要特性</th>
</tr>
</thead>
<tbody>
<tr>
<td>木</td>
<td>春</td>
<td>生長、發展</td>
</tr>
<tr>
<td>火</td>
<td>夏</td>
<td>熱烈、擴張</td>
</tr>
<tr>
<td>土</td>
<td>四季交替</td>
<td>承載、轉化</td>
</tr>
<tr>
<td>金</td>
<td>秋</td>
<td>收斂、裁決</td>
</tr>
<tr>
<td>水</td>
<td>冬</td>
<td>收藏、潛藏</td>
</tr>
</tbody>
</table>
<p>金具有秋天的特性，例如成熟、收穫、裁剪、規範。</p>
<p>乾卦則象徵天道運行、秩序與主導力量，因此在象徵意義上也能與金相互呼應。</p>
<p>3. 乾卦代表西北方，而西北在後天八卦中屬金</p>
<p>後天八卦的方位與五行配合：</p>
<table>
<thead>
<tr>
<th>卦</th>
<th>方位</th>
<th>五行</th>
</tr>
</thead>
<tbody>
<tr>
<td>乾 ☰</td>
<td>西北</td>
<td>金</td>
</tr>
<tr>
<td>兌 ☱</td>
<td>正西</td>
<td>金</td>
</tr>
<tr>
<td>離 ☲</td>
<td>正南</td>
<td>火</td>
</tr>
<tr>
<td>震 ☳</td>
<td>正東</td>
<td>木</td>
</tr>
<tr>
<td>巽 ☴</td>
<td>東南</td>
<td>木</td>
</tr>
<tr>
<td>坎 ☵</td>
<td>正北</td>
<td>水</td>
</tr>
<tr>
<td>艮 ☶</td>
<td>東北</td>
<td>土</td>
</tr>
<tr>
<td>坤 ☷</td>
<td>西南</td>
<td>土</td>
</tr>
</tbody>
</table>
<p>這是乾卦屬金的一個重要依據。</p>
<h4>三、為什麼乾、兌都屬金？</h4>
<p>這是理解八卦五行非常重要的一點。</p>
<p>乾卦和兌卦都屬金，但兩者的金性並不完全相同。</p>
<h4>乾卦 ☰</h4>
<p>乾金</p>
<p>陽金</p>
<ul>
<li>天</li>
<li>父親</li>
<li>權威</li>
<li>領導</li>
<li>剛強</li>
<li>大金、大型金屬</li>
</ul>
<h4>兌卦 ☱</h4>
<p>兌金</p>
<p>陰金</p>
<ul>
<li>澤</li>
<li>少女</li>
<li>喜悅</li>
<li>言語</li>
<li>溝通</li>
<li>小型金屬、金飾</li>
</ul>
<p>在傳統命理與五行象義的延伸應用中，常將乾金視為陽金，兌金視為陰金。</p>
<p>這是一種陰陽五行的象徵性分類，而不是說所有金屬都能嚴格分成兩類。</p>
<h4>四、乾卦的金與《易經》乾卦六爻有什麼關係？</h4>
<p>乾卦最重要的經文是：</p>
<blockquote>
<p>天行健，君子以自強不息。</p>
</blockquote>
<p>乾卦六爻的發展過程：</p>
<table>
<thead>
<tr>
<th>爻位</th>
<th>爻辭</th>
<th>象徵意義</th>
</tr>
</thead>
<tbody>
<tr>
<td>初九</td>
<td>潛龍勿用</td>
<td>潛藏、等待時機</td>
</tr>
<tr>
<td>九二</td>
<td>見龍在田</td>
<td>開始展現能力</td>
</tr>
<tr>
<td>九三</td>
<td>君子終日乾乾</td>
<td>努力精進</td>
</tr>
<tr>
<td>九四</td>
<td>或躍在淵</td>
<td>準備突破</td>
</tr>
<tr>
<td>九五</td>
<td>飛龍在天</td>
<td>事業達到高峰</td>
</tr>
<tr>
<td>上九</td>
<td>亢龍有悔</td>
<td>過度剛強則容易衰退</td>
</tr>
</tbody>
</table>
<p>這六爻也可以用來理解乾金的象徵：</p>
<ul>
<li>金需要經過鍛鍊才能成器。</li>
<li>剛強需要適當節制。</li>
<li>權力需要配合智慧。</li>
<li>過度剛硬反而容易折損。</li>
</ul>
<p>因此，乾卦雖然代表剛健，但並不是鼓勵一味強硬，而是強調剛健有度。</p>
<h4>五、特別注意：先天八卦與後天八卦的差異</h4>
<p>這裡有一個容易混淆的地方。</p>
<table>
<thead>
<tr>
<th>比較</th>
<th>先天八卦</th>
<th>後天八卦</th>
</tr>
</thead>
<tbody>
<tr>
<td>乾的位置</td>
<td>南方</td>
<td>西北</td>
</tr>
<tr>
<td>乾的基本象徵</td>
<td>天、純陽</td>
<td>天、純陽</td>
</tr>
<tr>
<td>五行配屬</td>
<td>常用後天五行系統配金</td>
<td>金</td>
</tr>
<tr>
<td>主要用途</td>
<td>陰陽、宇宙生成秩序</td>
<td>方位、時序、五行應用</td>
</tr>
</tbody>
</table>
<p>也就是說，乾卦的基本卦德是純陽、健行與天道；乾屬金則是八卦與五行配合後的象徵分類。</p>
<p>最重要的結論：</p>
<p>乾卦稱為金，並不是因為乾卦本身就是金屬，而是因為乾所代表的天、純陽、剛健、權威，以及後天八卦中的西北方位，都與五行金的象徵系統相互呼應。</p>
<hr>
<p>第一卦含意:<br></p>
<h4>易經第一卦：乾卦——真正的含意與人生智慧</h4>
<p>《易經》六十四卦的第一卦是 乾卦（䷀），卦名為「乾」，卦辭是：</p>
<blockquote>
<p>乾：元、亨、利、貞。</p>
</blockquote>
<p>乾卦代表天，代表純陽，也代表創造、生命力、主動性、領導力，以及宇宙生生不息的運行法則。</p>
<p>但是，如果只把乾卦解釋成「天行健，君子以自強不息」，其實還沒有理解乾卦最深刻的意義。</p>
<p>乾卦真正要告訴人的，不只是要努力，而是要理解：一個具有創造能力的人，如何順應時機、培養實力、掌握進退，最後完成自己的生命使命。</p>
<p>乾卦六爻，正好描述一個生命或事業從潛伏、成長、成熟、發揮影響力，到盛極而知退的完整歷程。</p>
<p>以下從哲學思想、卦象結構、卦辭、六爻及人生實踐幾個層次深入說明。</p>
<h4>一、乾卦的基本結構</h4>
<h4>䷀</h4>
<p>乾卦</p>
<p>六爻皆陽</p>
<p>上卦：乾 ☰<br> 下卦：乾 ☰</p>
<p>乾上乾下</p>
<p>純陽之卦</p>
<h4>六爻結構（由下往上）</h4>
<p>第6爻</p>
<p>上九：亢龍有悔</p>
<p>第5爻</p>
<p>九五：飛龍在天</p>
<p>第4爻</p>
<p>九四：或躍在淵</p>
<p>第3爻</p>
<p>九三：君子終日乾乾</p>
<p>第2爻</p>
<p>九二：見龍在田</p>
<p>第1爻</p>
<p>初九：潛龍勿用</p>
<p>六爻由下而上代表事物發展的六個階段；陽爻以完整的長線表示。</p>
<h4>1. 為什麼乾卦六爻全部都是陽爻？</h4>
<p>《易經》的基本符號只有兩種：</p>
<ul>
<li>陽爻（⚊）：完整不斷的線，象徵陽、主動、創造、發展。</li>
<li>陰爻（⚋）：中間斷開的線，象徵陰、承受、柔順、包容。</li>
</ul>
<p>乾卦六條爻全部是陽爻，代表陽氣充分發揮。</p>
<p>但這並不是說陽永遠比陰好，而是乾卦專門呈現一種純粹的創造力量。</p>
<p>例如：</p>
<ul>
<li>太陽持續運行，提供生命能量。</li>
<li>天體運轉，形成日月四時。</li>
<li>生物不斷繁衍，生命持續延伸。</li>
<li>人透過思想與行動，創造新的事物。</li>
</ul>
<p>這些都可以用乾的精神來理解。</p>
<h4>2. 乾為什麼代表天？</h4>
<p>《說卦傳》說：</p>
<blockquote>
<p>乾為天，為圓，為君，為父，為玉，為金……</p>
</blockquote>
<p>乾所代表的天，不只是我們頭頂上看到的天空，而是古人對宇宙運行規律的抽象理解。</p>
<p>天具有幾個重要特性：</p>
<ol>
<li>創造性：萬物得以開始。</li>
<li>運動性：宇宙沒有停止運行。</li>
<li>規律性：日月、四季都有秩序。</li>
<li>持續性：不因個別事物的變化而停止。</li>
<li>主導性：具有推動萬物發展的力量。</li>
</ol>
<p>因此，乾卦的核心不是單純的強大，而是具有創造能力，同時能夠持續運行的力量。</p>
<h4>二、乾卦最重要的四個字：元、亨、利、貞</h4>
<p>乾卦卦辭只有四個字，卻包含非常完整的人生哲學。</p>
<blockquote>
<p>元亨利貞。</p>
</blockquote>
<p>這四個字可以看成一個完整的生命發展循環。</p>
<h4>乾卦四德：生命發展的四個原則</h4>
<h4>元</h4>
<p>創始</p>
<p>找到方向，產生新的生命與構想。</p>
<p>開始的智慧</p>
<h4>亨</h4>
<p>通達</p>
<p>讓事物順利發展，建立溝通與合作。</p>
<p>發展的智慧</p>
<h4>利</h4>
<p>適宜</p>
<p>使發展有所成果，讓各方得到適當利益。</p>
<p>成就的智慧</p>
<h4>貞</h4>
<p>正固</p>
<p>堅守正道，使成果能夠持續。</p>
<p>守成的智慧</p>
<h4>（一）元：所有偉大事物都需要一個正確的開始</h4>
<p>元代表起始、根本、創造的源頭。</p>
<p>在人生中，元不只是有一個想法，而是：</p>
<ul>
<li>確認自己真正想完成的事情。</li>
<li>建立正確的價值觀。</li>
<li>找到值得投入的方向。</li>
<li>具有從無到有的創造能力。</li>
</ul>
<p>例如，一個人想學習程式設計，真正的元不是購買電腦或安裝軟體，而是理解自己為什麼要學，以及希望創造什麼。</p>
<p>人生智慧：開始之前，先確定方向；不要只因為有力量，就急著使用力量。</p>
<h4>（二）亨：有了開始，還必須讓事物順利發展</h4>
<p>亨代表通達、暢通、發展。</p>
<p>有些人有理想、有能力，卻無法實現，原因可能是：</p>
<ul>
<li>不懂得與別人合作。</li>
<li>不願意接受不同意見。</li>
<li>不知道如何調整方法。</li>
<li>過度堅持自己的想法。</li>
</ul>
<p>乾卦的亨，提醒我們創造力量必須能夠形成有效的發展。</p>
<p>人生智慧：真正的能力，不只是自己能做，而是能讓事情順利完成。</p>
<h4>（三）利：成功不只是擁有，而是讓成果產生價值</h4>
<p>利不是單純追求金錢或個人利益。</p>
<p>它包含適宜、合宜、各得其所的意義。</p>
<p>例如：</p>
<ul>
<li>事業成功，應該讓客戶得到價值。</li>
<li>學習有所成果，應該能夠實際運用。</li>
<li>擁有領導權，應該讓團隊成長。</li>
<li>累積財富，應該能夠改善生活。</li>
</ul>
<p>人生智慧：真正的成就，不是只有自己獲利，而是讓創造出來的事物具有正面價值。</p>
<h4>（四）貞：成功之後，仍然要守住正確的原則</h4>
<p>貞代表正固、堅定、守正。</p>
<p>這是乾卦非常重要的一個思想。</p>
<p>一個人可能：</p>
<ul>
<li>年輕時努力奮鬥。</li>
<li>中年時事業成功。</li>
<li>後來擁有財富與地位。</li>
</ul>
<p>但如果失去原來的原則，成功就可能變成失敗的起點。</p>
<p>所以貞不是僵化不變，而是在變化中保持正確的核心。</p>
<p>人生智慧：可以改變方法，但不能輕易放棄原則。</p>
<h4>三、乾卦最重要的核心：六爻代表人生六個階段</h4>
<p>這是理解乾卦最值得深入研究的部分。</p>
<p>乾卦不是只描述一個成功者的狀態，而是描述一個人如何從沒有機會、逐漸累積能力、開始發揮影響力，最後面對權力與成功所帶來的考驗。</p>
<p>六爻的順序不能顛倒，因為它具有明確的時間與發展意義。</p>
<h4>第一爻：初九——潛龍勿用</h4>
<blockquote>
<p>初九：潛龍勿用。</p>
<p>象曰：潛龍勿用，陽在下也。</p>
</blockquote>
<p>第一階段：潛伏與蓄積</p>
<p>真正含意：有能力，不代表現在就是發揮能力的時候。</p>
<p>龍在中國傳統文化中，象徵具有變化能力、生命力及巨大潛能的存在。</p>
<p>潛龍，就是具有龍的能力，卻尚未顯現出來。</p>
<p>這裡有一個很重要的人生觀念：</p>
<p>一個人即使具有很好的天賦，也不代表任何時間都適合展現自己。</p>
<p>例如：</p>
<ul>
<li>剛進入一個新領域，還沒有足夠經驗。</li>
<li>剛開始創業，還沒有建立穩定的基礎。</li>
<li>學習一項技術，還沒有熟練到能夠獨立完成。</li>
<li>具有領導能力，但還沒有得到適當的機會。</li>
</ul>
<p>此時最重要的事情不是急著表現，而是累積實力。</p>
<p>人生智慧：</p>
<ol>
<li>不因為有能力就急於表現。</li>
<li>不因為暫時沒有機會而否定自己。</li>
<li>利用不被注意的時間充實自己。</li>
<li>觀察環境，等待適當時機。</li>
<li>把潛在能力轉化成真正的實力。</li>
<li>知道何時不行動，也是一種智慧。</li>
</ol>
<p>這一爻最重要的提醒是：</p>
<p>潛伏不是失敗，而是為未來的發展準備力量。</p>
<h4>第二爻：九二——見龍在田，利見大人</h4>
<blockquote>
<p>九二：見龍在田，利見大人。</p>
<p>象曰：見龍在田，德施普也。</p>
</blockquote>
<p>第二階段：初步展現與建立信用</p>
<p>真正含意：當能力逐漸成熟，就應該適度展現，讓別人看見你的價值。</p>
<p>龍已經不再潛藏，而是出現在田野之上。</p>
<p>田野代表接近人群、實際生活與具體環境。</p>
<p>這個階段的人，已經有能力開始做事，但還沒有達到完全掌握局面的程度。</p>
<p>例如：</p>
<ul>
<li>學習者開始能夠獨立完成專案。</li>
<li>創業者開始建立自己的客戶群。</li>
<li>技術人員開始能夠解決實際問題。</li>
<li>年輕領導者開始獲得團隊信任。</li>
</ul>
<p>其中「利見大人」尤其值得注意。</p>
<p>大人不只是有權勢的人，也可以理解為具有德行、智慧、經驗與判斷能力的人。</p>
<p>它可以包含兩個方向：</p>
<ol>
<li>尋找值得學習的前輩、導師。</li>
<li>讓真正有能力的人看見自己的價值。</li>
</ol>
<p>人生智慧：</p>
<ol>
<li>把學習成果實際運用。</li>
<li>適度展現自己的能力。</li>
<li>建立誠信與良好聲譽。</li>
<li>主動接近有智慧的人。</li>
<li>不斷擴大自己的影響範圍。</li>
<li>以實際貢獻取得別人的信任。</li>
</ol>
<p>這一爻的重點是：</p>
<p>有實力之後，不必永遠隱藏，但必須透過實際貢獻建立地位。</p>
<h4>第三爻：九三——君子終日乾乾，夕惕若，厲，無咎</h4>
<blockquote>
<p>九三：君子終日乾乾，夕惕若，厲，無咎。</p>
<p>象曰：終日乾乾，反復道也。</p>
</blockquote>
<p>第三階段：持續精進與自我警惕</p>
<p>這一爻是乾卦中非常值得現代人重視的一爻。</p>
<p>真正含意：一個人開始有所成就之後，真正的考驗才剛剛開始。</p>
<p>「終日乾乾」就是整天勤勉不懈。</p>
<p>「夕惕若」則是到了晚上，仍然保持警惕，反省自己。</p>
<p>為什麼這個階段特別危險？</p>
<p>因為這時候的人：</p>
<ul>
<li>已經具有一定能力。</li>
<li>開始獲得別人的肯定。</li>
<li>有了一些成果。</li>
<li>可能開始承擔更大的責任。</li>
<li>但還沒有完全掌握環境與局勢。</li>
</ul>
<p>因此，最容易犯的錯誤就是自滿。</p>
<p>例如，一位工程師已經能夠獨立完成程式開發，但如果不再學習新的技術，就可能逐漸落後。</p>
<p>一位企業經營者已經成功建立公司，但如果忽略市場變化，也可能使公司陷入危機。</p>
<p>這一爻強調的不是盲目工作，而是持續精進與反省。</p>
<p>人生智慧：</p>
<ol>
<li>不因為已經成功就停止學習。</li>
<li>白天努力做事，晚上檢討得失。</li>
<li>對自己的決策保持警覺。</li>
<li>不斷修正錯誤與不足。</li>
<li>在責任增加時，更要謹慎。</li>
<li>讓勤奮與自我反省成為長期習慣。</li>
</ol>
<p>這一爻的核心是：</p>
<p>真正的自強，不是一直向外追求成就，而是持續向內修正自己。</p>
<h4>第四爻：九四——或躍在淵，無咎</h4>
<blockquote>
<p>九四：或躍在淵，無咎。</p>
<p>象曰：或躍在淵，進無咎也。</p>
</blockquote>
<p>第四階段：突破與審慎抉擇</p>
<p>真正含意：當一個人已經具備一定實力，就必須面對是否進一步突破的選擇。</p>
<p>「或躍」的或字很重要。</p>
<p>它表示尚在考慮、觀察，還沒有完全確定。</p>
<p>龍已經具有躍起的能力，但仍然處在深淵附近。</p>
<p>這是一個非常特殊的階段：</p>
<p>向前一步，可能進入新的境界；如果準備不足，也可能遭遇挫折。</p>
<p>例如：</p>
<ul>
<li>是否辭職創業？</li>
<li>是否接受更高階的管理職位？</li>
<li>是否投入一項新的研究？</li>
<li>是否擴大企業規模？</li>
<li>是否從技術專家轉型為領導者？</li>
</ul>
<p>這一爻不是叫人永遠保守，而是要求人在重大轉折之前，充分評估條件。</p>
<p>人生智慧：</p>
<ol>
<li>突破之前先評估自己的實力。</li>
<li>觀察環境是否提供適當機會。</li>
<li>不因為別人的成功而盲目跟進。</li>
<li>必要時可以前進，也可以暫時等待。</li>
<li>做出重要決定時，考慮可能的風險。</li>
<li>一旦條件成熟，就要勇於採取行動。</li>
</ol>
<p>這一爻的核心是：</p>
<p>真正的勇氣不是盲目冒險，而是在了解風險後，仍然有能力做出正確的選擇。</p>
<h4>第五爻：九五——飛龍在天，利見大人</h4>
<blockquote>
<p>九五：飛龍在天，利見大人。</p>
<p>象曰：飛龍在天，大人造也。</p>
</blockquote>
<p>第五階段：成熟、領導與成就</p>
<p>這是乾卦中最具有代表性的一爻。</p>
<p>真正含意：當一個人的能力、德行、時機與環境都達到適當條件時，就能充分發揮影響力。</p>
<p>龍已經飛上天空，象徵能力得到充分發揮。</p>
<p>九五在傳統卦位中是陽爻居陽位，又處於上卦中央，具有中正之象，因此被視為乾卦最理想的發展位置。</p>
<p>這個階段不只是個人成功，更代表開始能夠影響其他人。</p>
<p>例如：</p>
<ul>
<li>一位教師不只自己知識豐富，還能培養更多優秀學生。</li>
<li>一位企業家不只經營成功，還能建立良好的企業文化。</li>
<li>一位研究者不只完成自己的研究，還能啟發下一代。</li>
<li>一位領導者不只擁有權力，還能讓組織發揮最大價值。</li>
</ul>
<p>值得注意的是，九五仍然有「利見大人」這句話。</p>
<p>這表示即使已經達到很高的位置，也仍然需要智慧、德行與良好的合作關係。</p>
<p>人生智慧：</p>
<ol>
<li>在適當時機充分發揮能力。</li>
<li>將個人成就轉化成群體價值。</li>
<li>以德行建立真正的領導力。</li>
<li>尊重人才，善用人才。</li>
<li>不以權力滿足個人慾望。</li>
<li>成功之後，仍然保持謙遜與正直。</li>
</ol>
<p>這一爻的核心是：</p>
<p>最高的成就，不是自己飛得多高，而是能夠讓更多人一起成長。</p>
<h4>第六爻：上九——亢龍有悔</h4>
<blockquote>
<p>上九：亢龍有悔。</p>
<p>象曰：亢龍有悔，盈不可久也。</p>
</blockquote>
<p>第六階段：盛極而衰與知所進退</p>
<p>這一爻是乾卦最重要的警告。</p>
<p>真正含意：當一個人已經達到極高的位置，如果不知道適時調整與退讓，原來的優勢就可能轉化成危機。</p>
<p>「亢」就是過高、過度、超越適當限度。</p>
<p>龍已經飛得很高，但卻沒有適當的空間繼續發展。</p>
<p>為什麼會有悔？</p>
<p>因為事物的發展有其限度。</p>
<ul>
<li>權力過大，容易失去制衡。</li>
<li>財富過多而不知節制，可能招致風險。</li>
<li>過度自信，容易忽略別人的意見。</li>
<li>過度擴張，可能使組織失去控制。</li>
<li>過度追求成功，可能犧牲健康與生活。</li>
</ul>
<p>乾卦在這裡提出了一個非常深刻的觀念：</p>
<p>成功本身並不是最大的危險，不知道成功之後應該如何調整，才是真正的危險。</p>
<p>人生智慧：</p>
<ol>
<li>成功時不要過度自滿。</li>
<li>權力越大，責任越大。</li>
<li>不要把暫時的優勢當成永久的優勢。</li>
<li>知道何時應該讓位與授權。</li>
<li>適度節制自己的慾望。</li>
<li>在事物達到高峰時，就應該思考下一階段的轉型。</li>
</ol>
<p>這一爻的核心是：</p>
<p>能夠向上攀登是能力，能夠在高峰時適時調整，才是真正的智慧。</p>
<h4>四、乾卦最後還有一個容易被忽略的內容：用九</h4>
<p>一般人在研究乾卦時，常常只研究六條爻，卻忽略了「用九」。</p>
<blockquote>
<p>用九：見群龍無首，吉。</p>
<p>象曰：用九，天德不可為首也。</p>
</blockquote>
<p>這句話非常值得深思。</p>
<p>「群龍無首」通常容易被理解成沒有領導者，但在乾卦中，它還有更深的哲學意義。</p>
<p>它描述一種理想的境界：</p>
<p>每個人都有能力，每個人都能發揮作用，卻不需要有人永遠以自己為中心。</p>
<p>例如：</p>
<ul>
<li>一個成熟的團隊，不需要所有事情都由主管決定。</li>
<li>一個成熟的社會，不應該只依賴單一英雄。</li>
<li>一個成熟的組織，應該讓每個人都有發揮才能的空間。</li>
<li>一個真正有智慧的領導者，知道如何培養其他領導者。</li>
</ul>
<p>這裡的「無首」並非沒有秩序，而是不執著於一個人永遠居於首位。</p>
<p>這也使乾卦的思想從個人的自強，提升到群體共同發展的境界。</p>
<p>用九的人生智慧：</p>
<ol>
<li>不要凡事以自己為中心。</li>
<li>尊重每個人的能力。</li>
<li>培養可以獨立運作的團隊。</li>
<li>不以權力控制所有人。</li>
<li>讓共同目標高於個人地位。</li>
<li>學習放下對領導位置的執著。</li>
</ol>
<p>這是乾卦從個人成功走向群體和諧的一個重要補充。</p>
<h4>五、乾卦六爻其實是一個完整的生命週期</h4>
<p>如果將六爻連接起來，就會發現它並不是六個互不相關的故事，而是一個完整的動態發展模型。</p>
<h4>乾卦六階段人生發展模型</h4>
<ol>
<li>
<p>潛龍勿用</p>
<p>潛伏、學習、儲備能力。</p>
<p>關鍵：等待與準備</p>
</li>
<li>
<p>見龍在田</p>
<p>初步展現能力，建立信用與人際關係。</p>
<p>關鍵：展現與貢獻</p>
</li>
<li>
<p>終日乾乾</p>
<p>持續努力，反省不足，保持警覺。</p>
<p>關鍵：精進與自省</p>
</li>
<li>
<p>或躍在淵</p>
<p>面對重大轉型，衡量風險與機會。</p>
<p>關鍵：判斷與突破</p>
</li>
<li>
<p>飛龍在天</p>
<p>充分發揮能力，承擔責任，創造價值。</p>
<p>關鍵：成就與領導</p>
</li>
<li>
<p>亢龍有悔</p>
<p>防止過度擴張，適時調整，懂得進退。</p>
<p>關鍵：節制與轉化</p>
</li>
</ol>
<p>這六個階段可以應用在很多事情上：</p>
<table>
<thead>
<tr>
<th>人生領域</th>
<th>乾卦六階段的應用</th>
</tr>
</thead>
<tbody>
<tr>
<td>學習</td>
<td>入門、實作、精進、突破、精通、傳承</td>
</tr>
<tr>
<td>事業</td>
<td>準備、起步、成長、轉型、巔峰、交棒</td>
</tr>
<tr>
<td>創業</td>
<td>構想、試作、經營、擴張、成熟、轉型</td>
</tr>
<tr>
<td>人際</td>
<td>觀察、接觸、建立信任、深化關係、合作、尊重界線</td>
</tr>
<tr>
<td>個人成長</td>
<td>自我探索、展現能力、自律、突破、成熟、放下執著</td>
</tr>
</tbody>
</table>
<p>但必須注意：六爻不一定是每個人一生只能經歷一次的階段。任何新的事業、學習或人生目標，都可能重新經歷這六個階段。</p>
<p>這就是乾卦的動態意義。</p>
<h4>六、乾卦最深刻的哲學：天行健，君子以自強不息</h4>
<blockquote>
<p>《象傳》：天行健，君子以自強不息。</p>
</blockquote>
<p>這句話幾乎是所有人認識《易經》時最熟悉的話，但它其實包含三個層次。</p>
<h4>1. 天行健：宇宙具有持續運行的力量</h4>
<p>天不是靜止的。</p>
<p>日月運行、四季更替、萬物生長，都是自然界持續變化的現象。</p>
<p>古人透過觀察自然，體會到一種重要的道理：</p>
<p>萬物不會因為某個個體的意志而停止運行。</p>
<p>因此，人不能只依靠過去的成就生活，而應該不斷適應新的環境。</p>
<h4>2. 君子：人應該學習自然的運行法則</h4>
<p>乾卦並不是要求人模仿天的力量去征服一切。</p>
<p>而是要求人學習天的：</p>
<ul>
<li>持續性。</li>
<li>規律性。</li>
<li>創造性。</li>
<li>不懈怠的精神。</li>
<li>不因一時得失而停止發展的態度。</li>
</ul>
<p>君子不是單純有知識的人，而是能夠將道理實踐在生活中的人。</p>
<h4>3. 自強不息：不斷改善自己，而不是不斷強迫自己</h4>
<p>這是最容易被誤解的地方。</p>
<p>自強不息不等於：</p>
<ul>
<li>每天工作到筋疲力盡。</li>
<li>永遠不能休息。</li>
<li>一定要贏過別人。</li>
<li>不允許自己失敗。</li>
<li>永遠不能改變方向。</li>
</ul>
<p>真正的自強，是持續改善自己的能力與品格。</p>
<p>有時候努力是進步，有時候休息是為了恢復，有時候改變方向也是一種進步。</p>
<p>這與乾卦六爻的精神完全一致。</p>
<p>自強不息，不是永遠向前衝，而是永遠不停止對正確方向的追求。</p>
<h4>七、乾卦與坤卦：為什麼第一卦是乾，第二卦是坤？</h4>
<p>乾卦（第一卦）</p>
<ul>
<li>天</li>
<li>創造</li>
<li>主動</li>
<li>剛健</li>
<li>自強</li>
</ul>
<p>坤卦（第二卦）</p>
<ul>
<li>地</li>
<li>承載</li>
<li>接納</li>
<li>柔順</li>
<li>包容</li>
</ul>
<p>乾卦之後就是坤卦，這個排列具有重要的哲學意義。</p>
<p>乾代表創造的力量，坤代表承載與孕育的力量。</p>
<p>可以用一個例子來理解：</p>
<p>假設有人想建立一所學校。</p>
<p>乾的精神是：</p>
<ul>
<li>提出理想。</li>
<li>規劃方向。</li>
<li>開創制度。</li>
<li>推動改革。</li>
</ul>
<p>坤的精神是：</p>
<ul>
<li>接納學生。</li>
<li>培育人才。</li>
<li>建立穩定環境。</li>
<li>讓教育理念真正落實。</li>
</ul>
<p>只有創造，沒有承載，理想可能無法實現。</p>
<p>只有承載，沒有創造，事物也可能缺乏新的發展。</p>
<p>因此，乾坤並不是彼此對立，而是共同形成創造與實現的條件。</p>
<p>從這個角度看：</p>
<p>乾卦教人如何創造，坤卦教人如何承載；真正完整的人生，需要同時具備兩種能力。</p>
<h4>八、乾卦在現代人生中的五個重要應用</h4>
<p>將乾卦轉化成現代生活的實際原則，可以得到以下五項智慧。</p>
<h4>1. 面對學習：不要急於求成</h4>
<p>對任何新的知識或技術，都應該經過潛伏、練習、實作與精進。</p>
<p>不要因為短時間沒有成果，就認為自己沒有能力。</p>
<p>對應初九與九二。</p>
<h4>2. 面對事業：能力與時機同樣重要</h4>
<p>不是所有機會都值得接受，也不是所有能力都適合立即展現。</p>
<p>應該觀察環境、累積實力，等待適當的突破點。</p>
<p>對應九三與九四。</p>
<h4>3. 面對成功：把個人成就轉化為共同價值</h4>
<p>真正有價值的成功，不只是自己擁有更多，而是能夠創造更多正面的影響。</p>
<p>對應九五。</p>
<h4>4. 面對權力：不要讓成功成為自我膨脹的理由</h4>
<p>一個人越成功，越需要保持謙遜、接受批評、尊重別人。</p>
<p>對應上九。</p>
<h4>5. 面對人生：學習適時交棒與放下</h4>
<p>人生不只是追求登上高峰，也包括如何讓後來的人繼續成長。</p>
<p>對應用九。</p>
<h4>九、乾卦真正的含意：六十四卦的第一個人生哲學</h4>
<p>如果要將乾卦濃縮成一套完整的人生哲學，我認為可以歸納為以下六個層次。</p>
<table>
<thead>
<tr>
<th>層次</th>
<th>乾卦原文</th>
<th>真正的人生意義</th>
</tr>
</thead>
<tbody>
<tr>
<td>一</td>
<td>潛龍勿用</td>
<td>不成熟時，先培養實力</td>
</tr>
<tr>
<td>二</td>
<td>見龍在田</td>
<td>有能力時，開始貢獻</td>
</tr>
<tr>
<td>三</td>
<td>終日乾乾</td>
<td>有成就時，持續精進</td>
</tr>
<tr>
<td>四</td>
<td>或躍在淵</td>
<td>面臨轉折時，審慎突破</td>
</tr>
<tr>
<td>五</td>
<td>飛龍在天</td>
<td>成熟之後，創造更大價值</td>
</tr>
<tr>
<td>六</td>
<td>亢龍有悔</td>
<td>到達高峰，懂得節制與轉型</td>
</tr>
</tbody>
</table>
<p>而元亨利貞，則是貫穿整個過程的四項基本原則：</p>
<ul>
<li>元：開始要有正確的方向。</li>
<li>亨：發展要能通達。</li>
<li>利：成果要合宜且有價值。</li>
<li>貞：始終堅守正確的原則。</li>
</ul>
<h4>我認為乾卦最值得現代人深思的三個問題</h4>
<p>第一個問題：我現在處於哪個階段？</p>
<p>是潛龍，還是見龍？是正在突破，還是已經到達高峰？</p>
<p>如果不能正確認識自己所處的位置，就容易採取錯誤的行動。</p>
<p>第二個問題：我現在應該進取，還是等待？</p>
<p>不是所有努力都有立即的成果，也不是所有機會都值得把握。</p>
<p>乾卦告訴我們，行動必須配合時機。</p>
<p>第三個問題：如果我已經成功，接下來應該做什麼？</p>
<p>是繼續擴張，還是培養接班人？是繼續掌握權力，還是讓更多人發揮能力？</p>
<p>這是上九與用九帶給我們最重要的反省。</p>
<h4>十、最後總結：乾卦的真正人生智慧</h4>
<h4>乾卦人生哲學</h4>
<h4>自強不息，知進知退</h4>
<h4>六項人生原則</h4>
<p>1、未成熟時，懂得潛藏與蓄積。</p>
<p>2、有能力時，懂得展現與貢獻。</p>
<p>3、有成就時，懂得精進與反省。</p>
<p>4、遇轉折時，懂得判斷與突破。</p>
<p>5、達高峰時，懂得謙遜與分享。</p>
<p>6、面對極盛時，懂得節制與轉化。</p>
<h4>四項根本德性</h4>
<h4>元</h4>
<p>創始</p>
<h4>亨</h4>
<p>通達</p>
<h4>利</h4>
<p>合宜</p>
<h4>貞</h4>
<p>正固</p>
<h4>最終境界</h4>
<h4>群龍無首，吉</h4>
<p>不執著於個人地位，讓每個人都能發揮自己的力量。</p>
<p>最後，我想特別指出一件事情：</p>
<p>乾卦並不是鼓勵人一輩子不斷追求成功，而是教人如何正確地開始、成長、突破、成功，以及在成功之後仍然保有智慧。</p>
<p>它的最高境界，不是成為永遠高高在上的飛龍，而是即使擁有強大的力量，也不被自己的力量所限制。</p>
<p>這才是乾卦從「自強不息」走向「群龍無首」的深層哲學。</p>
<p>
<script src="https://cdn.jsdelivr.net/pyodide/v0.27.0/full/pyodide.js"></script>
<script>
(function () {
  "use strict";

  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, CODE: 1, PRE: 1 };

  function status(msg) {
    var el = document.getElementById("gua_status");
    if (el) el.textContent = msg || "";
  }

  function hasMarkup(text) {
    return text && text.indexOf("[[") !== -1 && text.indexOf("]]") !== -1;
  }

  /** 找出含 [[...]] 且適合替換的元素（略過 script/style 等） */
  function findMarkupElements(root) {
    var result = [];
    var all = (root || document.body).getElementsByTagName("*");
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (SKIP[el.tagName]) continue;
      if (el.id === "gua_status") continue;
      // 只處理「自身有文字、且子元素沒有再包一層含標記的容器」的節點，
      // 或明確標了 class="gua-markup"
      var text = el.innerText || el.textContent || "";
      if (!hasMarkup(text)) continue;
      if (el.classList && el.classList.contains("gua-markup")) {
        result.push(el);
        continue;
      }
      // 若子元素也有標記，交給子元素處理，避免重複
      var childHas = false;
      for (var j = 0; j < el.children.length; j++) {
        var ct = el.children[j].innerText || el.children[j].textContent || "";
        if (hasMarkup(ct)) { childHas = true; break; }
      }
      if (!childHas) result.push(el);
    }
    return result;
  }

  async function installLocalModule(pyodide, url, name) {
    try {
      var res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return false;
      var code = await res.text();
      if (!code || !code.trim()) return false;
      pyodide.FS.writeFile(name + ".py", code);
      return true;
    } catch (e) {
      console.warn("change.py 載入失敗", url, e);
      return false;
    }
  }

  async function renderElement(pyodide, el) {
    var text = el.innerText || el.textContent || "";
    if (!hasMarkup(text)) return;
    pyodide.globals.set("_gua_src", text);
    var html = await pyodide.runPythonAsync(
      "import change\n" +
      "change.render_markup(_gua_src, target_div=None, default_method='html', lang='zh')\n"
    );
    if (html) el.innerHTML = html;
  }

  async function main() {
    if (!document.body) {
      setTimeout(main, 100);
      return;
    }

    var targets = findMarkupElements(document.body);
    if (targets.length === 0) {
      // 內容可能稍後才出現（ViewPage 動態載入）
      if (!main._tries) main._tries = 0;
      if (main._tries++ < 20) {
        setTimeout(main, 300);
      }
      return;
    }

    if (typeof loadPyodide !== "function") {
      status("Pyodide 尚未載入…");
      setTimeout(main, 400);
      return;
    }

    status("載入卦象元件…");
    var pyodide;
    try {
      pyodide = await loadPyodide();
    } catch (e) {
      status("Pyodide 失敗：" + e);
      return;
    }

    var ok =
      (await installLocalModule(pyodide, "/static/change.py", "change")) ||
      (await installLocalModule(pyodide, "/downloads/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../static/change.py", "change")) ||
      (await installLocalModule(pyodide, "./../downloas/change.py", "change"));
    if (!ok) {
      status("請將 change.py 放到 /static/change.py");
      return;
    }

    try {
      targets = findMarkupElements(document.body);
      for (var i = 0; i < targets.length; i++) {
        await renderElement(pyodide, targets[i]);
      }
      status("");
    } catch (e) {
      status("渲染失敗：" + e);
      console.error(e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", main);
  } else {
    main();
  }
})();
</script>
</p>
